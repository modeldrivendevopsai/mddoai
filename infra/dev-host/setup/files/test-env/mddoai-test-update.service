[Unit]
Description=Update and start the MDDOAI Test environment
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@DEV_USER@
ExecStart=/opt/mddoai-test/update.sh
# A first build of the whole stack takes several minutes; this is generous
# (engineering guess).
TimeoutStartSec=1h
