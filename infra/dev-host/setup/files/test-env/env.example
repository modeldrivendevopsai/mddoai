# Settings and secrets of the Test environment. The setup stage copies this
# file to /opt/mddoai-test/.env once, with a fresh cookie secret, and never
# overwrites it. update.sh links it as the test clone's ai/.env, where
# docker compose reads it.

# The branch to run when none was chosen with the "Test environment branch"
# workflow, or the chosen one was deleted.
TEST_BRANCH=main
REPO_URL=https://github.com/modeldrivendevopsai/mddoai.git
# The public name the Cloudflare tunnel routes here.
TEST_HOSTNAME=test.mddoai.com
# Only members of this GitHub organization can log in.
GITHUB_ORG=modeldrivendevopsai

# The long string in the install command Cloudflare shows for the tunnel.
TUNNEL_TOKEN=
# From the GitHub OAuth app owned by the organization.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Encrypts the login cookie. Changing it logs everyone out.
OAUTH2_COOKIE_SECRET=

# Every docker compose command in the test clone's ai/ folder acts on the
# Test environment (the stack plus the gateway), never on the dev stack.
COMPOSE_PROJECT_NAME=ai-test
COMPOSE_FILE=docker-compose.yml:/opt/mddoai-test/compose.yaml
# On 127.0.0.1 only, next to the dev stack's 5173 and 8000.
UI_PORT=5273
AI_LAYER_PORT=127.0.0.1:8200
UI_ALLOWED_HOSTS="${TEST_HOSTNAME} localhost 127.0.0.1"
