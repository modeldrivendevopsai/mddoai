# Copy to terraform.tfvars (gitignored) and fill in.
# The Hetzner API token is not set here: export HCLOUD_TOKEN instead.

# Each developer's public IP, as /32 for a single IPv4 address.
ssh_allowed_cidrs = ["203.0.113.7/32"]

# Optional overrides; the defaults are in variables.tf.
# ssh_public_key_path = "~/.ssh/mddoai_dev.pub"
# server_type         = "cx43"
# location            = "nbg1"   # pick one where the server type is available
