# Settings and secrets of the Test environment. The setup stage copies this
# file to .env in the Test environment's folder once, with a fresh cookie
# secret, and never overwrites it. update.sh links it as the clone's ai/.env,
# where docker compose reads it.

# The public name the Cloudflare tunnel routes here.
TEST_HOSTNAME=test1.mddoai.com
# The GitHub usernames that can log in, exactly as on their GitHub profiles
# (same capitals), separated by commas without spaces: alice,bob
GITHUB_USERS=

# The long string in the install command Cloudflare shows for the tunnel.
TUNNEL_TOKEN=
# From the GitHub OAuth app made for the Test environment.
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Encrypts the login cookie. Changing it logs everyone out.
OAUTH2_COOKIE_SECRET=

# Every docker compose command in the clone's ai/ folder acts on the Test
# environment (the stack plus the gateway in this folder), never on the dev
# stack. The gateway's path is relative to repo/ai.
COMPOSE_PROJECT_NAME=ai-test
COMPOSE_FILE=docker-compose.yml:../../compose.yaml
# On 127.0.0.1 only, next to the dev stack's 5173 and 8000.
UI_PORT=5273
AI_LAYER_PORT=127.0.0.1:8200
UI_ALLOWED_HOSTS="${TEST_HOSTNAME} localhost 127.0.0.1"
