# The Test environment's settings and secrets. Setup copies this to .env once.

TEST_HOSTNAME=test1.mddoai.com
# Who can log in: exact GitHub names, comma separated, like alice,bob
GITHUB_USERS=

# From the tunnel's install command in Cloudflare
TUNNEL_TOKEN=
# From the GitHub OAuth app
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
# Setup fills it in. Changing it logs everyone out.
OAUTH2_COOKIE_SECRET=
# How long a login lasts
OAUTH2_COOKIE_EXPIRE=24h

# Makes docker compose in repo/ai act on the Test environment, not the dev stack
COMPOSE_PROJECT_NAME=ai-test
COMPOSE_FILE=docker-compose.yml:../../compose.yaml

# The stack's settings (see ai/.env.example), on ports next to the dev stack's
UI_PORT=5273
AI_LAYER_PORT=127.0.0.1:8200
UI_ALLOWED_HOSTS="${TEST_HOSTNAME} localhost 127.0.0.1"
UI_MAX_BODY_SIZE=6m
# With a unit: oauth2-proxy uses it too
UI_PROXY_READ_TIMEOUT=120s
