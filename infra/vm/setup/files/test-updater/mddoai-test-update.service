[Unit]
Description=Update and start the MDDOAI Test environment
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@DEV_USER@
ExecStart=@UPDATER@ @TEST_DIR@
# A first build of the whole stack takes several minutes; this is generous
# (engineering guess).
TimeoutStartSec=1h
