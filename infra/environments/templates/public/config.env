# The settings of an environment served under a public name behind a GitHub
# login, made from templates/public/: copy that folder to
# infra/environments/<name>/ and fill in every line of this file. Only the
# template's copy is committed; an environment's own config.env stays on the
# machine that runs it, so it holds the secrets too.

# The public name it is served under
PUBLIC_HOSTNAME=
# The UI's port, on 127.0.0.1 only, like 5273. Different from every other
# environment's on the same machine, as is AI_LAYER_PORT.
UI_PORT=
# ai-layer's address and port, like 127.0.0.1:8200. Keep 127.0.0.1: the
# tunnel can reach anything listening on the VM's other addresses.
AI_LAYER_PORT=
# The host names the UI answers to, separated by spaces, like
# "${PUBLIC_HOSTNAME} localhost 127.0.0.1"
UI_ALLOWED_HOSTS=
# Above the agents' 5 MiB upload limit, like 6m
UI_MAX_BODY_SIZE=
# Above the longest request the UI waits on: a model check, up to 90s. Slower
# work, such as a generation or a chat answer, answers at once and runs in the
# background. With a unit, like 120s:
# oauth2-proxy needs one. Under Cloudflare's 125s.
UI_PROXY_READ_TIMEOUT=

# Each folder below is its own setting, an absolute path. ai/data holds the
# starting platforms and prompt configs, and ai/data/README.md suggests a layout.

# The models you pick from. You create it. The stack only reads it.
# Everyone who can log in can list the files in it and read its .swarch files.
MDDOAI_WORKSPACE_DIR=
# Must already hold the platforms.
MDDOAI_PLATFORMS_DIR=
# Must already hold the agents' starting prompt configs, a folder each.
MDDOAI_PROMPTS_DIR=
# Files uploaded to the agents as attachments, a folder each. Docker creates it.
MDDOAI_ATTACHMENTS_DIR=
# Generated by the services. Docker creates them.
MDDOAI_RUNS_DIR=
MDDOAI_CHATS_DIR=
MDDOAI_PIPELINES_DIR=

# The LLM API keys file, an absolute path. It must exist and stay out of git.
# ai/ai-layer/.env.example shows what goes in it.
MDDOAI_LLM_KEYS_FILE=

# Who can log in: exact GitHub names, comma separated
GITHUB_USERS=
# How long a login lasts, like 24h
OAUTH2_COOKIE_EXPIRE=
# The GitHub OAuth app's client ID
OAUTH2_CLIENT_ID=

# Secrets
# From the tunnel's install command in Cloudflare
TUNNEL_TOKEN=
# From the GitHub OAuth app
OAUTH2_CLIENT_SECRET=
# Encrypts the login cookie; changing it logs everyone out. Make one with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
