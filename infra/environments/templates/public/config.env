# The settings of an environment served under a public name behind a GitHub
# login, made from templates/public/: copy that folder to
# infra/environments/<name>/ and fill in every line of this file. Only the
# template's copy is committed; an environment's own config.env stays on the
# machine that runs it, so it holds the secrets too.

# The public name it is served under
PUBLIC_HOSTNAME=
# The UI's port, on 127.0.0.1 only, like 5273. Different from every other
# environment's on the same machine, as is AI_LAYER_PORT.
UI_PORT=
# ai-layer's address and port, like 127.0.0.1:8200. Keep 127.0.0.1: the
# tunnel can reach anything listening on the VM's other addresses.
AI_LAYER_PORT=
# The host names the UI answers to, separated by spaces, like
# "${PUBLIC_HOSTNAME} localhost 127.0.0.1"
UI_ALLOWED_HOSTS=
# Above the agents' 5 MiB upload limit, like 6m
UI_MAX_BODY_SIZE=
# With a unit, like 120s: oauth2-proxy needs one. Under Cloudflare's 125s.
UI_PROXY_READ_TIMEOUT=

# Who can log in: exact GitHub names, comma separated
GITHUB_USERS=
# How long a login lasts, like 24h
OAUTH2_COOKIE_EXPIRE=
# The GitHub OAuth app's client ID
OAUTH2_CLIENT_ID=

# Secrets
# From the tunnel's install command in Cloudflare
TUNNEL_TOKEN=
# From the GitHub OAuth app
OAUTH2_CLIENT_SECRET=
# Encrypts the login cookie; changing it logs everyone out. Make one with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
