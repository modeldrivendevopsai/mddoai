# The settings of an environment reached only from its own machine, made from
# templates/dev/: copy that folder to infra/environments/<name>/ and fill in
# this file. Only the template's copy is committed; an environment's own
# config.env stays on the machine that runs it.

# The UI's port, on 127.0.0.1 only, like 5173
UI_PORT=
# ai-layer's address and port, like 127.0.0.1:8000. Keep 127.0.0.1 unless
# another machine needs it.
AI_LAYER_PORT=
# The host names the UI answers to, separated by spaces, like
# "localhost 127.0.0.1"
UI_ALLOWED_HOSTS=
# Above the agents' 5 MiB upload limit, like 6m
UI_MAX_BODY_SIZE=
# With a unit, like 120s. Under Cloudflare's 125s.
UI_PROXY_READ_TIMEOUT=
