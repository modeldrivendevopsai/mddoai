# The settings of an environment reached only from its own machine, made from
# templates/dev/: copy that folder to infra/environments/<name>/ and fill in
# this file. Only the template's copy is committed; an environment's own
# config.env stays on the machine that runs it.

# The UI's port, on 127.0.0.1 only, like 5173
UI_PORT=
# ai-layer's address and port, like 127.0.0.1:8000. Keep 127.0.0.1 unless
# another machine needs it.
AI_LAYER_PORT=
# The host names the UI answers to, separated by spaces, like
# "localhost 127.0.0.1"
UI_ALLOWED_HOSTS=
# Above the agents' 5 MiB upload limit, like 6m
UI_MAX_BODY_SIZE=
# Above the longest request the UI waits on: a model check, up to 90s. Slower
# work, such as a generation or a chat answer, answers at once and runs in the
# background. With a unit, like 120s. Under
# Cloudflare's 125s.
UI_PROXY_READ_TIMEOUT=

# The folders the stack reads and keeps its files in. Each is its own setting,
# an absolute path, and you may put them all under one folder: the repository's
# ai/data/README.md suggests a layout. The repository ships the starting content
# some of them need under ai/data.

# What people supply or maintain. The services read all of these and write some.
# The folder the "Generate a CI/CD pipeline" mode picks models from. It is
# yours: create it, own it, and put your .swarch files in it. The stack only
# reads it.
MDDOAI_WORKSPACE_DIR=
# The platforms the generator generates for. It must already hold them.
MDDOAI_PLATFORMS_DIR=
# The prompt configs of each prompt agent, edited in the UI. Each must already
# hold that agent's starting configs.
MDDOAI_PSM_PROMPTS_DIR=
MDDOAI_ATL_PROMPTS_DIR=
MDDOAI_ACCELEO_PROMPTS_DIR=
# The files uploaded as attachments to each prompt agent. Docker creates them.
MDDOAI_PSM_ATTACHMENTS_DIR=
MDDOAI_ATL_ATTACHMENTS_DIR=
MDDOAI_ACCELEO_ATTACHMENTS_DIR=

# What the services generate. Docker creates them.
# Every run of the platform integration: each stage's attempts and manifest.
MDDOAI_RUNS_DIR=
# The compiled output the validators keep.
MDDOAI_VALIDATOR_OUTPUT_DIR=
# The pipelines generated so far.
MDDOAI_PIPELINES_DIR=

# The file with the LLM API keys that ai-layer reads, an absolute path. It holds
# secrets: keep it outside the repository or in a file git ignores, and readable by
# you only. It must already exist, and the repository's ai/ai-layer/.env.example
# shows what goes in it.
MDDOAI_LLM_KEYS_FILE=
