**/bin/
*.class
./test
# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# CRLF-stripped throwaway copy the ai/validator_agent gradle-builder compose
/plugins
__pycache__/
*.pyc

# Python virtual environments and caches
venv/
.venv/

# crawl4ai / Playwright downloaded artifacts (ai/retrieval/)
ai/retrieval/.playwright-browsers/
ai/retrieval/.crawl4ai/
ai/retrieval/global.yml

# third-party doc content fetched during retrieval testing, not ours to redistribute
ai/retrieval/samples/

# A .env that Compose would read on its own: settings stay in config.env.
ai/.env
infra/environments/*/.env

# Each environment's settings and secrets, kept only on the machine that runs
# it. The templates are committed.
infra/environments/*/config.env
!infra/environments/templates/*/config.env

# Internal-only working files (architecture diagrams, etc.), not for the repo
/.local/
