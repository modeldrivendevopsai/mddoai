**/bin/
*.class
./test
# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# CRLF-stripped throwaway copy the ai/validator_agent gradle-builder compose
/plugins
__pycache__/
*.pyc

# Python virtual environments and caches
venv/
.venv/

# crawl4ai / Playwright downloaded artifacts (ai/retrieval/)
ai/retrieval/.playwright-browsers/
ai/retrieval/.crawl4ai/
ai/retrieval/global.yml

# third-party doc content fetched during retrieval testing, not ours to redistribute
ai/retrieval/samples/

# Per-run persisted validator artifacts + results (ai/integration_runner/
# stages/_validation.py), in-memory run state's on-disk counterpart, gone
# on restart the same way the in-memory run history already is
ai/integration_runner/runs/

# Real human-uploaded attachment files (ai/psm_agent/routes/uploads.py) -
# unlike ai/psm_agent/prompts/ (config JSON, deliberately git-committed so
# a real starting prompt always exists), an upload is per-deployment,
# arbitrary content a human added, not shipped, curated starting material.
ai/psm_agent/attachments/

# A live prompt-config save and its version history (created the moment a
# human clicks Save in the prompt builder UI) - per-deployment runtime
# state, not shipped content, same reasoning as the attachments/ and runs/
# entries above. Only *.default.json (the curated, deliberately
# git-committed starting content every deployment falls back to) is real,
# committed source.
ai/psm_agent/prompts/*/history/
ai/psm_agent/prompts/*/*.json
!ai/psm_agent/prompts/*/*.default.json

# Same reasoning as ai/psm_agent's own entries above, applied to the atl and
# acceleo stages' own real, UI-editable prompt config and file uploads.
ai/atl_agent/attachments/
ai/atl_agent/prompts/*/history/
ai/atl_agent/prompts/*/*.json
!ai/atl_agent/prompts/*/*.default.json
ai/acceleo_agent/attachments/
ai/acceleo_agent/prompts/*/history/
ai/acceleo_agent/prompts/*/*.json
!ai/acceleo_agent/prompts/*/*.default.json

# Internal-only working files (architecture diagrams, etc.), not for the repo
/.local/
