        </mxCell>
        <mxCell id="c4-l3r-routes" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Fetch Routes&lt;/b&gt;&lt;br&gt;[Component: FastAPI]&lt;br&gt;&lt;br&gt;Crawl a site from a start page, or fetch one page, which skips the crawl and dedupe. Takes a hint and exclusions." vertex="1">
          <mxGeometry height="140" width="280" x="3420" y="4800" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-page" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Page Builder&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Shapes each result into a page, marks one with almost no content as failed, and checks again after the cleanup." vertex="1">
          <mxGeometry height="140" width="280" x="2940" y="5050" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-crawler" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Adaptive Crawler&lt;/b&gt;&lt;br&gt;[Component: Crawl4AI]&lt;br&gt;&lt;br&gt;Loops: fetch a page, rank its links, fetch more, until confident enough, at its page or depth limit, or out of good links." vertex="1">
          <mxGeometry height="140" width="280" x="3420" y="5050" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-ranker" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Link Ranker&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Orders the candidate links by a cheap statistical score, then asks the model which look like syntax references." vertex="1">
          <mxGeometry height="140" width="280" x="3900" y="5050" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-dedupe" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Deduplicator&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Drops long paragraphs that already appeared earlier. Runs before and after the cleanup." vertex="1">
          <mxGeometry height="140" width="280" x="2940" y="5300" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-fetcher" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Page Fetcher&lt;/b&gt;&lt;br&gt;[Component: Crawl4AI, headless Chromium]&lt;br&gt;&lt;br&gt;One browser visit gets a page's content, trimmed by rules, and its links. Refuses non-public addresses. Pages are cached." vertex="1">
          <mxGeometry height="140" width="280" x="3420" y="5300" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-scope" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Scope Resolver&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Keeps the crawl under the start page's address, and drops the addresses the caller excluded." vertex="1">
          <mxGeometry height="140" width="280" x="3900" y="5300" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-cleaner" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Content Cleaner&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Removes what the rule-based pass missed, chunk by chunk, with the model. Remembers each page: a repeat costs no call." vertex="1">
          <mxGeometry height="140" width="280" x="2940" y="5550" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-ir" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Integration Runner&lt;/b&gt;&lt;br&gt;[External Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Asks for a crawl in the docs stage, and for single pages to fill a gap." vertex="1">
          <mxGeometry height="150" width="280" x="3720" y="4370" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3r-ai" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;AI Layer&lt;/b&gt;&lt;br&gt;[External Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Routes requests to a language model provider." vertex="1">
