        <mxCell id="devhost-14" edge="1" parent="devhostV1" source="devhost-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.6875;" target="devhost-12" value="UI ports forwarded inside SSH">
          <mxGeometry relative="1" x="-0.6" as="geometry">
            <Array as="points">
              <mxPoint x="690" y="340" />
              <mxPoint x="690" y="295" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="devhost-15" edge="1" parent="devhostV1" source="devhost-6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=cross;endFill=0;strokeWidth=1.5;strokeColor=#b85450;dashed=1;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.7619;" target="devhost-7" value="blocked">
