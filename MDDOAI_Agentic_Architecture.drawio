        </mxCell>
        <mxCell id="c4-l3a-j" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Journal&lt;/b&gt;&lt;br&gt;[External Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Keeps chats and platforms." vertex="1">
