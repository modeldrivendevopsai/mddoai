        <mxCell id="c4-l3b-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="Level 3b: Component Diagram, Integration Runner" vertex="1">
