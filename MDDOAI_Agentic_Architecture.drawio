        </mxCell>
        <mxCell id="devhost-48" parent="devhostV4" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#707070;strokeColor=#454545;" value="&lt;b&gt;Their own stack&lt;/b&gt;&lt;br&gt;own Compose project and ports&lt;br&gt;mapped to localhost on their PC" vertex="1">
          <mxGeometry height="70" width="270" x="740" y="660" as="geometry" />
        </mxCell>
        <mxCell id="devhost-53" edge="1" parent="devhostV4" source="devhost-44" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="devhost-51" value="SSH">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-57" parent="devhostV3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;fontStyle=2;" value="&lt;b&gt;V3&lt;/b&gt; · A public demo of main for people outside the project, kept apart from the Test environment. Planned: who may use it, and how its AI credits are protected, are still to be designed." vertex="1">
          <mxGeometry height="40" width="1740" x="40" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="devhostV4" parent="0" value="V4: other developers on the same VM" visible="0" />
        <mxCell id="devhost-66" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#4a7fb5;strokeColor=#2c5580;" value="&lt;b&gt;Test stack&lt;/b&gt;&lt;br&gt;own clone on main&lt;br&gt;built UI, no dev servers&lt;br&gt;own Compose project" vertex="1">
          <mxGeometry height="100" width="180" x="1100" y="430" as="geometry" />
        </mxCell>
        <mxCell id="devhost-64" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#707070;strokeColor=#454545;" value="&lt;b&gt;Update timer&lt;/b&gt;&lt;br&gt;every few minutes:&lt;br&gt;fetch, and rebuild&lt;br&gt;when main has&lt;br&gt;a new commit" vertex="1">
          <mxGeometry height="100" width="160" x="1350" y="430" as="geometry" />
        </mxCell>
        <mxCell id="devhost-71" edge="1" parent="devhostV2" source="devhost-64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="devhost-66" value="rebuild">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-72" edge="1" parent="devhostV2" source="devhost-64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#666666;dashed=1;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.2222;entryY=1;" target="devhost-78" value="fetch main&lt;br&gt;(outbound)">
          <mxGeometry relative="1" x="0.36" as="geometry">
            <Array as="points">
              <mxPoint x="1640" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="devhost-70" edge="1" parent="devhostV2" source="devhost-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.5;entryY=1;" target="devhost-66" value="signed in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-73" parent="devhostV4" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;fontStyle=2;" value="&lt;b&gt;V4&lt;/b&gt; · Each other developer gets their own Linux account, home, clone and branch, and their own copy of the app (its own Compose project and ports, mapped back to localhost on their PC). An admin adds a developer with one command: the account, their SSH keys from GitHub, and their IP on the firewall list. SSH stays limited to listed IPs. Stacks fit in memory because the UI is served built, as in V2. Anyone with Docker access has admin-level control of the VM, so it suits developers who trust each other." vertex="1">
          <mxGeometry height="40" width="1740" x="40" y="1120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C4 Architecture" id="mddoai-c4">
    <mxGraphModel dx="5004" dy="2679" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="16240" pageHeight="6500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c4-l2-system" parent="1" style="shape=rect;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=light-dark(#666666, #5ea9f2);verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=14;spacingTop=10;strokeWidth=4;dashPattern=8 8;" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;MDDOAI [Software System]&lt;/span&gt;" vertex="1">
          <mxGeometry height="1800" width="3490" x="500" y="2030" as="geometry" />
        </mxCell>
        <mxCell id="c4-agents" parent="1" style="shape=mxgraph.c4.boundary;fillColor=none;strokeColor=light-dark(#CCCCCC, #e3e3e3);dashed=1;verticalAlign=bottom;align=right;fontStyle=1;fontSize=13;html=1;container=0;strokeWidth=5;fontColor=#555555;spacingRight=10;spacingBottom=6;" value="Stage agents [Group of containers]: write the platform&#39;s files with AI, then validate them" vertex="1">
          <mxGeometry height="290" width="1080" x="1960" y="2930" as="geometry" />
        </mxCell>
        <mxCell id="c4-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="MDDOAI: C4 Architecture" vertex="1">
          <mxGeometry height="40" width="1700" as="geometry" />
        </mxCell>
        <mxCell id="c4-subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" value="Level 1 shows who uses MDDOAI, level 2 the containers it is made of, and level 3 the components inside some of those containers. Every box says what it is for, with the technology in brackets." vertex="1">
          <mxGeometry height="50" width="2600" y="46" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-person" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="Person" vertex="1">
          <mxGeometry height="110" width="120" y="120" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="MDDOAI, the system in focus" vertex="1">
          <mxGeometry height="70" width="190" x="170" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-ext" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="External system" vertex="1">
          <mxGeometry height="70" width="190" x="410" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-cont" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="Container: a service or app that runs on its own" vertex="1">
          <mxGeometry height="70" width="190" x="650" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-comp" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="Component: a part inside a container" vertex="1">
          <mxGeometry height="70" width="190" x="890" y="140" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-db" parent="1" style="shape=mxgraph.c4.database;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="Data store" vertex="1">
          <mxGeometry height="100" width="150" x="1130" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c4-glossary" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" value="Terms: a SWArch model is a software architecture model. PIM is the platform-independent model made from it. PSM is a platform-specific model, here the metamodel of one CI/CD platform. ATL is a model-to-model transformation language, and Acceleo a model-to-text template language. EMF is the Eclipse Modeling Framework, which the validators use." vertex="1">
          <mxGeometry height="60" width="2600" y="245" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="Level 1: System Context" vertex="1">
          <mxGeometry height="40" width="700" x="2320" y="350" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-integrator" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Platform Integrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Adds support for a new CI/CD platform, and reviews what the AI produces at each stage." vertex="1">
          <mxGeometry height="220" width="230" x="2700" y="420" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-author" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Pipeline Author&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Gives a software architecture model and gets CI/CD pipelines for the chosen platforms. Needs no model-driven engineering skills." vertex="1">
          <mxGeometry height="220" width="230" x="3520" y="420" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;MDDOAI&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Generates CI/CD pipelines from software architecture models. Learns a new CI/CD platform from its documentation, with a person reviewing each stage." vertex="1">
          <mxGeometry height="200" width="340" x="3100" y="770" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;LLM Providers&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Language models that write the platform&#39;s files and the chat replies. Free ones first, a paid one as the last resort." vertex="1">
          <mxGeometry height="160" width="300" x="2620" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-docs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;CI/CD Platform Documentation&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;The public syntax reference of the platform being added." vertex="1">
          <mxGeometry height="160" width="300" x="3120" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-cicd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;CI/CD Platforms&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Where the generated pipelines run." vertex="1">
          <mxGeometry height="160" width="300" x="3485" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="c4-l2-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="Level 2: Container Diagram" vertex="1">
          <mxGeometry height="40" width="800" x="40" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="c4-l2-integrator" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Platform Integrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Adds support for a new CI/CD platform." vertex="1">
          <mxGeometry height="220" width="230" x="1220" y="1760" as="geometry" />
        </mxCell>
        <mxCell id="c4-l2-author" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Pipeline Author&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Generates CI/CD pipelines from a model." vertex="1">
          <mxGeometry height="220" width="230" x="1900" y="1760" as="geometry" />
        </mxCell>
        <mxCell id="c4-ui" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;UI Host&lt;/b&gt;&lt;br&gt;[Container: React, nginx]&lt;br&gt;&lt;br&gt;App shell. Serves the UI and forwards each call to its backend." vertex="1">
          <mxGeometry height="150" width="280" x="1540" y="2120" as="geometry" />
        </mxCell>
        <mxCell id="c4-remotes" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;UI Remotes&lt;/b&gt;&lt;br&gt;[Container: React, Module Federation]&lt;br&gt;&lt;br&gt;The chat, the stepper and one panel per stage, loaded by the shell at run time." vertex="1">
          <mxGeometry height="150" width="280" x="1980" y="2120" as="geometry" />
        </mxCell>
        <mxCell id="c4-orch" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Chat and REST gateway. Narrates events, and lets the model call the actions a button calls." vertex="1">
          <mxGeometry height="150" width="280" x="570" y="2400" as="geometry" />
        </mxCell>
        <mxCell id="c4-pgen" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Pipeline Generator&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Checks a model, generates a pipeline for each chosen platform, keeps and re-checks the results." vertex="1">
          <mxGeometry height="150" width="280" x="3320" y="2400" as="geometry" />
        </mxCell>
        <mxCell id="c4-runner" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Integration Runner&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;The stage state machine, from docs to generation. Records every event, publishes a finished platform." vertex="1">
          <mxGeometry height="150" width="280" x="1580" y="2680" as="geometry" />
        </mxCell>
        <mxCell id="c4-retr" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Retrieval&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Crawls a platform&#39;s documentation and returns clean markdown." vertex="1">
          <mxGeometry height="150" width="280" x="900" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-ser" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Serialization Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Labels the documentation with PIM concepts. Makes no model call." vertex="1">
          <mxGeometry height="150" width="280" x="1230" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-pim" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;PIM Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Serves the curated platform-independent model knowledge base." vertex="1">
          <mxGeometry height="150" width="280" x="1640" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-psm" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;PSM Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Writes the platform&#39;s metamodel, or checks an existing one against the platform&#39;s documentation." vertex="1">
          <mxGeometry height="150" width="280" x="2000" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-atl" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;ATL Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Writes the transformation from the platform-independent model to the platform&#39;s model." vertex="1">
          <mxGeometry height="150" width="280" x="2360" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-acc" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Acceleo Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Writes the template that turns the platform&#39;s model into the pipeline file." vertex="1">
          <mxGeometry height="150" width="280" x="2720" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-val" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Validator Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI, Java]&lt;br&gt;&lt;br&gt;Validates the files the agents write, and the models people give, with the real EMF validators. Checks pipeline files." vertex="1">
          <mxGeometry height="150" width="280" x="3140" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-exe" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Execution Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI, Java]&lt;br&gt;&lt;br&gt;Runs a real ATL transformation or Acceleo template on a model and returns the output." vertex="1">
          <mxGeometry height="150" width="280" x="3500" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-ai" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;AI Layer&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Routes each request to a language model provider, with automatic fallback." vertex="1">
          <mxGeometry height="150" width="280" x="570" y="3405" as="geometry" />
        </mxCell>
        <mxCell id="c4-engine" parent="1" style="shape=mxgraph.c4.database;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;MDE Engine&lt;/b&gt;&lt;br&gt;[Shared volume: Java libraries]&lt;br&gt;&lt;br&gt;The headless validators and executors, built once by a Gradle container. Each agent runs them as a fresh Java process." vertex="1">
          <mxGeometry height="150" width="600" x="3160" y="3320" as="geometry" />
        </mxCell>
        <mxCell id="c4-journal" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Journal&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Keeps the data folders: runs, chats, platforms, prompt configs, uploads and pipelines. Other services use its API." vertex="1">
          <mxGeometry height="130" width="2270" x="1610" y="3630" as="geometry" />
        </mxCell>
        <mxCell id="c4-data" parent="1" style="shape=mxgraph.c4.database;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Data Folders&lt;/b&gt;&lt;br&gt;[Container: Filesystem]&lt;br&gt;&lt;br&gt;Where the Journal keeps what it stores. Reached through the Journal&#39;s API." vertex="1">
          <mxGeometry height="150" width="280" x="1080" y="3620" as="geometry" />
        </mxCell>
        <mxCell id="c4-l2-llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;LLM Providers&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Language models. Free ones first." vertex="1">
          <mxGeometry height="160" width="300" x="560" y="3900" as="geometry" />
        </mxCell>
        <mxCell id="c4-l2-docs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;CI/CD Platform Documentation&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;The platform&#39;s public syntax reference." vertex="1">
