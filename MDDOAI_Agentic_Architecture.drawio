        <mxCell id="devhost-28" edge="1" parent="devhostV2" source="devhost-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#666666;dashed=1;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.8333;entryY=1;" target="devhost-78" value="login">
          <mxGeometry relative="1" x="-0.73" as="geometry">
