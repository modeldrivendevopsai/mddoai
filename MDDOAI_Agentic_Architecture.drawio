        <mxCell id="c4-l3s-routes" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Agent Routes&lt;/b&gt;&lt;br&gt;[Component: FastAPI]&lt;br&gt;&lt;br&gt;Generate a file for the stage, and manage its prompt config, attachments and uploads." vertex="1">
          <mxGeometry height="140" width="280" x="7530" y="4800" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3s-config" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Prompt Config&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;The saved recipe: attachments (text, files, values from the run), versions and learned constraints. Turns it into prompt parts." vertex="1">
          <mxGeometry height="140" width="280" x="7050" y="5050" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3s-stage" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Stage Generation&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Resolves the config once and merges the constraints, then runs the loop, or the mock chain when mock is on." vertex="1">
          <mxGeometry height="140" width="280" x="7530" y="5050" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3s-mock" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Mock Chain&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;With mock on, returns fixed files that fit together, calls no model. The prompt is still built and the files still checked." vertex="1">
          <mxGeometry height="140" width="280" x="8010" y="5050" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3s-loop" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Generation Loop&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Asks the model, checks it, feeds each error back as a constraint, up to a limit, then returns the last draft as invalid." vertex="1">
          <mxGeometry height="140" width="280" x="7530" y="5300" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3s-builder" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Prompt Assembler&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Puts the prompt parts and the constraints together into the prompt for the model." vertex="1">
