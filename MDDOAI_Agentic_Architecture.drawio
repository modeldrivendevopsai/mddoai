          <mxGeometry height="140" width="280" x="2060" y="7210" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3b-events" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Event Log&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Records every real thing that happens to a run. Stores, never narrates." vertex="1">
          <mxGeometry height="140" width="280" x="1100" y="7460" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3b-pipeline" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Pipeline&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;The state machine: one run&#39;s stages, reviews, constraints and background work." vertex="1">
