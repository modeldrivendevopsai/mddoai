        <mxCell id="c4-key-db" parent="1" style="shape=mxgraph.c4.database;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="Data store" vertex="1">
          <mxGeometry height="100" width="150" x="1130" y="125" as="geometry" />
        </mxCell>
        <mxCell id="c4-glossary" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" value="Terms: a SWArch model is a software architecture model. PIM is the platform-independent model made from it. PSM is a platform-specific model, here the metamodel of one CI/CD platform. ATL is a model-to-model transformation language, and Acceleo a model-to-text template language. EMF is the Eclipse Modeling Framework, which the validators use." vertex="1">
          <mxGeometry height="60" width="2600" y="245" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="Level 1: System Context" vertex="1">
          <mxGeometry height="40" width="700" x="2320" y="350" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-integrator" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Platform Integrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Adds support for a new CI/CD platform, and reviews what the AI produces at each stage." vertex="1">
          <mxGeometry height="220" width="230" x="2700" y="420" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-author" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Pipeline Author&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Gives a software architecture model and gets CI/CD pipelines for the chosen platforms. Needs no model-driven engineering skills." vertex="1">
          <mxGeometry height="220" width="230" x="3520" y="420" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;MDDOAI&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;Generates CI/CD pipelines from software architecture models. Learns a new CI/CD platform from its documentation, with a person reviewing each stage." vertex="1">
          <mxGeometry height="200" width="340" x="3100" y="770" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;LLM Providers&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Language models that write the platform&#39;s files and the chat replies. Free ones first, a paid one as the last resort." vertex="1">
          <mxGeometry height="160" width="300" x="2620" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-docs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;CI/CD Platform Documentation&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;The public syntax reference of the platform being added." vertex="1">
          <mxGeometry height="160" width="300" x="3120" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="c4-l1-cicd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#666666;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;CI/CD Platforms&lt;/b&gt;&lt;br&gt;[External System]&lt;br&gt;&lt;br&gt;Where the generated pipelines run." vertex="1">
          <mxGeometry height="160" width="300" x="3485" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="c4-l2-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="Level 2: Container Diagram" vertex="1">
          <mxGeometry height="40" width="800" x="40" y="1700" as="geometry" />
