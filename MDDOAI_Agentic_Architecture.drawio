          <mxGeometry height="140" width="280" x="1130" y="5300" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3a-store" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Chat Store&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Keeps each run&#39;s chat in the Journal, so a restart repeats no narration." vertex="1">
