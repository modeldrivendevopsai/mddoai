        <mxCell id="c4-l3s-drift" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Drift Check&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;PSM agent only. When the platform has a metamodel, compares it with the platform's documentation. Never edits it." vertex="1">
          <mxGeometry height="140" width="280" x="8010" y="5550" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3s-ir" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Integration Runner&lt;/b&gt;&lt;br&gt;[External Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Asks a stage agent for a file, and edits its prompt config." vertex="1">
