        <mxCell id="1" parent="0" />
        <mxCell id="c4-l2-system" parent="1" style="shape=rect;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=light-dark(#666666, #5ea9f2);verticalAlign=top;align=left;spacingLeft=14;fontStyle=1;fontSize=14;spacingTop=10;strokeWidth=4;dashPattern=8 8;" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;MDDOAI [Software System]&lt;/span&gt;" vertex="1">
