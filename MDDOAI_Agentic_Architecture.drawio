          <mxGeometry height="290" width="1080" x="1960" y="2930" as="geometry" />
        </mxCell>
        <mxCell id="c4-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;" value="MDDOAI: C4 Architecture" vertex="1">
          <mxGeometry height="40" width="1700" as="geometry" />
        </mxCell>
        <mxCell id="c4-subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#555555;" value="Level 1 shows who uses MDDOAI, level 2 the containers it is made of, and level 3 the components inside some of those containers. Every box says what it is for, with the technology in brackets." vertex="1">
          <mxGeometry height="50" width="2600" y="46" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-person" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="Person" vertex="1">
          <mxGeometry height="110" width="120" y="120" as="geometry" />
        </mxCell>
        <mxCell id="c4-key-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="MDDOAI, the system in focus" vertex="1">
          <mxGeometry height="70" width="190" x="170" y="140" as="geometry" />
        </mxCell>
