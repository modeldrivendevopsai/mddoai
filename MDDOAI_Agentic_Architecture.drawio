        <mxCell id="c4-l3b-routes" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Routes&lt;/b&gt;&lt;br&gt;[Component: FastAPI]&lt;br&gt;&lt;br&gt;Start, review, rerun, fork and reset a run. Read the tries of a stage. Publish a platform. Pass prompt-config requests on." vertex="1">
          <mxGeometry height="140" width="280" x="1580" y="6960" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3b-publish" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Publishing&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Publishes a completed run&#39;s platform, from the attempt behind the approved pipeline." vertex="1">
          <mxGeometry height="140" width="280" x="2060" y="6960" as="geometry" />
        </mxCell>
        <mxCell id="c4-l3b-registry" parent="1" style="shape=mxgraph.c4.component;whiteSpace=wrap;html=1;fillColor=#63b3ed;strokeColor=#4b8bbd;fontColor=#000000;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Run Registry&lt;/b&gt;&lt;br&gt;[Component: Python]&lt;br&gt;&lt;br&gt;Which run is current. Starts, resumes, forks and resets runs, one at a time." vertex="1">
          <mxGeometry height="140" width="280" x="1580" y="7210" as="geometry" />
        </mxCell>
