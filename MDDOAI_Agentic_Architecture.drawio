        <mxCell id="c4-l2-integrator" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Platform Integrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Adds support for a new CI/CD platform." vertex="1">
          <mxGeometry height="220" width="230" x="1220" y="1760" as="geometry" />
        </mxCell>
        <mxCell id="c4-l2-author" parent="1" style="shape=mxgraph.c4.person;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;verticalAlign=top;paddingTop=44;" value="&lt;b&gt;Pipeline Author&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Generates CI/CD pipelines from a model." vertex="1">
          <mxGeometry height="220" width="230" x="1900" y="1760" as="geometry" />
        </mxCell>
        <mxCell id="c4-ui" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;UI Host&lt;/b&gt;&lt;br&gt;[Container: React, nginx]&lt;br&gt;&lt;br&gt;App shell. Serves the UI and forwards each call to its backend." vertex="1">
          <mxGeometry height="150" width="280" x="1540" y="2120" as="geometry" />
        </mxCell>
        <mxCell id="c4-remotes" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;UI Remotes&lt;/b&gt;&lt;br&gt;[Container: React, Module Federation]&lt;br&gt;&lt;br&gt;The chat, the stepper and one panel per stage, loaded by the shell at run time." vertex="1">
          <mxGeometry height="150" width="280" x="1980" y="2120" as="geometry" />
        </mxCell>
        <mxCell id="c4-orch" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Orchestrator&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Chat and REST gateway. Narrates events, and lets the model call the actions a button calls." vertex="1">
          <mxGeometry height="150" width="280" x="570" y="2400" as="geometry" />
        </mxCell>
        <mxCell id="c4-pgen" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Pipeline Generator&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Checks a model, generates a pipeline for each chosen platform, keeps and re-checks the results." vertex="1">
          <mxGeometry height="150" width="280" x="3320" y="2400" as="geometry" />
        </mxCell>
        <mxCell id="c4-runner" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Integration Runner&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;The stage state machine, from docs to generation. Records every event, publishes a finished platform." vertex="1">
          <mxGeometry height="150" width="280" x="1580" y="2680" as="geometry" />
        </mxCell>
        <mxCell id="c4-retr" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Retrieval&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Crawls a platform&#39;s documentation and returns clean markdown." vertex="1">
          <mxGeometry height="150" width="280" x="900" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-ser" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Serialization Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Labels the documentation with PIM concepts. Makes no model call." vertex="1">
          <mxGeometry height="150" width="280" x="1230" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-pim" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;PIM Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Serves the curated platform-independent model knowledge base." vertex="1">
          <mxGeometry height="150" width="280" x="1640" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-psm" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;PSM Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Writes the platform&#39;s metamodel, or checks an existing one against the platform&#39;s documentation." vertex="1">
          <mxGeometry height="150" width="280" x="2000" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-atl" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;ATL Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Writes the transformation from the platform-independent model to the platform&#39;s model." vertex="1">
          <mxGeometry height="150" width="280" x="2360" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-acc" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Acceleo Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Writes the template that turns the platform&#39;s model into the pipeline file." vertex="1">
          <mxGeometry height="150" width="280" x="2720" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-val" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Validator Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI, Java]&lt;br&gt;&lt;br&gt;Validates the files the agents write, and the models people give, with the real EMF validators. Checks pipeline files." vertex="1">
          <mxGeometry height="150" width="280" x="3140" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-exe" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;Execution Agent&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI, Java]&lt;br&gt;&lt;br&gt;Runs a real ATL transformation or Acceleo template on a model and returns the output." vertex="1">
          <mxGeometry height="150" width="280" x="3500" y="3000" as="geometry" />
        </mxCell>
        <mxCell id="c4-ai" parent="1" style="shape=mxgraph.c4.container;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;AI Layer&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;&lt;br&gt;Routes each request to a language model provider, with automatic fallback." vertex="1">
          <mxGeometry height="150" width="280" x="570" y="3405" as="geometry" />
        </mxCell>
        <mxCell id="c4-engine" parent="1" style="shape=mxgraph.c4.database;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=14;" value="&lt;b&gt;MDE Engine&lt;/b&gt;&lt;br&gt;[Shared volume: Java libraries]&lt;br&gt;&lt;br&gt;The headless validators and executors, built once by a Gradle container. Each agent runs them as a fresh Java process." vertex="1">
          <mxGeometry height="150" width="600" x="3160" y="3320" as="geometry" />
        </mxCell>
