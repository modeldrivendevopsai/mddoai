        <mxCell id="devhost-79" edge="1" parent="devhostV1" source="devhost-11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#666666;dashed=1;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" target="devhost-78" value="git over SSH, forwarded agent">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="875" y="100" />
              <mxPoint x="1690" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="devhost-16" parent="devhostV1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;fontStyle=2;" value="&lt;b&gt;V1&lt;/b&gt; · Nothing but SSH is reachable, and only from the developer&amp;#x27;s IP. The browser on the developer&amp;#x27;s PC reaches the app through the same encrypted SSH connection VS Code uses. Git on the VM reaches GitHub with the developer&amp;#x27;s own key, lent through agent forwarding, so no GitHub key is stored on the VM." vertex="1">
          <mxGeometry height="40" width="1740" x="40" y="950" as="geometry" />
        </mxCell>
        <mxCell id="devhostV2" parent="0" value="V2: Test environment on the same VM, GitHub login via Cloudflare Tunnel" visible="0" />
        <mxCell id="devhost-18" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#4a7fb5;strokeColor=#2c5580;" value="&lt;b&gt;Reviewer&lt;/b&gt;&lt;br&gt;browser, GitHub login" vertex="1">
          <mxGeometry height="70" width="240" x="70" y="795" as="geometry" />
        </mxCell>
        <mxCell id="devhost-80" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#8a8a8a;strokeColor=#555555;dashed=1;" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;our domain&lt;br&gt;hides the VM&#39;s IP" vertex="1">
          <mxGeometry height="80" width="150" x="380" y="790" as="geometry" />
        </mxCell>
        <mxCell id="devhost-21" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#4f9768;strokeColor=#2d5c3d;" value="&lt;b&gt;cloudflared&lt;/b&gt;&lt;br&gt;outbound tunnel,&lt;br&gt;no open ports" vertex="1">
          <mxGeometry height="80" width="200" x="740" y="790" as="geometry" />
        </mxCell>
        <mxCell id="devhost-22" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#8759a3;strokeColor=#5c3a72;" value="&lt;b&gt;oauth2-proxy&lt;/b&gt;&lt;br&gt;--github-user list" vertex="1">
          <mxGeometry height="80" width="200" x="1050" y="790" as="geometry" />
        </mxCell>
        <mxCell id="devhost-26" edge="1" parent="devhostV2" source="devhost-18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="devhost-80" value="HTTPS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-81" edge="1" parent="devhostV2" source="devhost-21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;startFill=1;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="devhost-80" value="tunnel&lt;br&gt;(outbound)">
          <mxGeometry relative="1" x="0.54" as="geometry" />
        </mxCell>
        <mxCell id="devhost-27" edge="1" parent="devhostV2" source="devhost-21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="devhost-22" value="every request">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-28" edge="1" parent="devhostV2" source="devhost-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#666666;dashed=1;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.8333;entryY=1;" target="devhost-78" value="login">
          <mxGeometry relative="1" x="-0.73" as="geometry">
            <Array as="points">
              <mxPoint x="1750" y="830" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="devhost-31" parent="devhostV2" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;fontStyle=2;" value="&lt;b&gt;V2&lt;/b&gt; · A Test environment runs beside the dev stack: its own clone and Compose project, and a built UI served as plain files instead of dev servers, so it stays light. It always runs the latest main; a timer rebuilds it when main has a new commit. Branches are tried on the dev stack. Reviewers reach it, never the dev stack, at one HTTPS address on our own domain served by Cloudflare. The VM opens no web port: cloudflared connects out to Cloudflare, and requests come back through that tunnel. oauth2-proxy lets only GitHub users on the list through. Nobody develops in it." vertex="1">
          <mxGeometry height="40" width="1740" x="40" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="devhostV3" parent="0" value="V3: public demo of main" visible="0" />
        <mxCell id="devhost-44" parent="devhostV4" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#4a7fb5;strokeColor=#2c5580;" value="&lt;b&gt;Other developer&lt;/b&gt;&lt;br&gt;VS Code + browser, from a listed IP" vertex="1">
          <mxGeometry height="70" width="240" x="70" y="565" as="geometry" />
        </mxCell>
        <mxCell id="devhost-51" parent="devhostV4" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#707070;strokeColor=#454545;" value="&lt;b&gt;Other developer&#39;s account&lt;/b&gt;&lt;br&gt;own home, clone and branch&lt;br&gt;keys from their GitHub, no sudo" vertex="1">
          <mxGeometry height="80" width="270" x="740" y="560" as="geometry" />
        </mxCell>
        <mxCell id="devhost-48" parent="devhostV4" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#707070;strokeColor=#454545;" value="&lt;b&gt;Their own stack&lt;/b&gt;&lt;br&gt;own Compose project and ports&lt;br&gt;mapped to localhost on their PC" vertex="1">
          <mxGeometry height="70" width="270" x="740" y="660" as="geometry" />
        </mxCell>
        <mxCell id="devhost-53" edge="1" parent="devhostV4" source="devhost-44" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="devhost-51" value="SSH">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-57" parent="devhostV3" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;fontStyle=2;" value="&lt;b&gt;V3&lt;/b&gt; · A public demo of main for people outside the project, kept apart from the Test environment. Planned: who may use it, and how its AI credits are protected, are still to be designed." vertex="1">
          <mxGeometry height="40" width="1740" x="40" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="devhostV4" parent="0" value="V4: other developers on the same VM" visible="0" />
        <mxCell id="devhost-66" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#4a7fb5;strokeColor=#2c5580;" value="&lt;b&gt;Test stack&lt;/b&gt;&lt;br&gt;own clone on main&lt;br&gt;built UI, no dev servers&lt;br&gt;own Compose project" vertex="1">
          <mxGeometry height="100" width="180" x="1100" y="430" as="geometry" />
        </mxCell>
        <mxCell id="devhost-64" parent="devhostV2" style="rounded=1;whiteSpace=wrap;html=1;fontColor=#ffffff;fontSize=12;fillColor=#707070;strokeColor=#454545;" value="&lt;b&gt;Update timer&lt;/b&gt;&lt;br&gt;every few minutes:&lt;br&gt;fetch, and rebuild&lt;br&gt;when main has&lt;br&gt;a new commit" vertex="1">
          <mxGeometry height="100" width="160" x="1350" y="430" as="geometry" />
        </mxCell>
        <mxCell id="devhost-71" edge="1" parent="devhostV2" source="devhost-64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" target="devhost-66" value="rebuild">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-72" edge="1" parent="devhostV2" source="devhost-64" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1;strokeColor=#666666;dashed=1;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.2222;entryY=1;" target="devhost-78" value="fetch main&lt;br&gt;(outbound)">
          <mxGeometry relative="1" x="0.36" as="geometry">
            <Array as="points">
              <mxPoint x="1640" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="devhost-70" edge="1" parent="devhostV2" source="devhost-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A2D6B;fontSize=11;fontColor=#4A2D6B;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.5;entryY=1;" target="devhost-66" value="signed in">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="devhost-73" parent="devhostV4" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;fontStyle=2;" value="&lt;b&gt;V4&lt;/b&gt; · Each other developer gets their own Linux account, home, clone and branch, and their own copy of the app (its own Compose project and ports, mapped back to localhost on their PC). An admin adds a developer with one command: the account, their SSH keys from GitHub, and their IP on the firewall list. SSH stays limited to listed IPs. Stacks fit in memory because the UI is served built, as in V2. Anyone with Docker access has admin-level control of the VM, so it suits developers who trust each other." vertex="1">
          <mxGeometry height="40" width="1740" x="40" y="1120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
