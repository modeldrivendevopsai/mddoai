[comment encoding = UTF-8 /]
[module generate('http://www.mddoai.com/mddoai/metamodel/bamboo')]

[query public generateVariableReference(variableDeclaration : VariableDeclaration) : String =
  '${bamboo.' + variableDeclaration.name + '}'
/]

[template public generateExpression(expression : Expression) post (trim())]
[if (expression.oclIsUndefined())]null[elseif (expression.oclIsTypeOf(StringLiteral))][expression.oclAsType(StringLiteral).value/][elseif (expression.oclIsTypeOf(IntegerLiteral))][expression.oclAsType(IntegerLiteral).value/][elseif (expression.oclIsTypeOf(DoubleLiteral))][expression.oclAsType(DoubleLiteral).value/][elseif (expression.oclIsTypeOf(BooleanLiteral))][if (expression.oclAsType(BooleanLiteral).value)]true[else]false[/if][elseif (expression.oclIsTypeOf(VariableReference))][generateVariableReference(expression.oclAsType(VariableReference).reference)/][elseif (expression.oclIsTypeOf(Concat))][generateConcat(expression.oclAsType(Concat))/][/if]
[/template]

[template public generateConcat(concat : Concat) post (trim())]
[for (expr : Expression | concat.expressions) separator ('')][generateExpression(expr)/][/for]
[/template]

[template public generateVariableAssignment(variableAssignment : VariableAssignment) post (trim())]
[variableAssignment.key.name/]: [generateExpression(variableAssignment.value)/]
[/template]

[template public generatePlanIdentifier(planIdentifier : PlanIdentifier) post (trim())]
[planIdentifier.projectKey/]-[planIdentifier.planKey/]
[/template]

[template public generateTaskCommon(task : AbstractTask)]
[if (not task.description.oclIsUndefined())]
        description: [generateExpression(task.description)/]
[/if]
[if (not task.enabled.oclIsUndefined())]
        enabled: [task.enabled/]
[/if]
[/template]

[template public generateTaskItem(task : AbstractTask)]
[if (task.oclIsTypeOf(CleanWorkingDirectoryTask))]
    - clean
[elseif (task.oclIsTypeOf(InjectVariablesTask))]
[generateInjectVariablesTask(task.oclAsType(InjectVariablesTask))/]
[elseif (task.oclIsTypeOf(ScriptTask))]
[generateScriptTask(task.oclAsType(ScriptTask))/]
[elseif (task.oclIsTypeOf(MavenTask))]
[generateMavenTask(task.oclAsType(MavenTask))/]
[elseif (task.oclIsTypeOf(NUnitRunnerTask))]
[generateNUnitRunnerTask(task.oclAsType(NUnitRunnerTask))/]
[elseif (task.oclIsTypeOf(VcsCheckoutTask))]
[generateVcsCheckoutTask(task.oclAsType(VcsCheckoutTask))/]
[elseif (task.oclIsTypeOf(VcsPushTask))]
[generateVcsPushTask(task.oclAsType(VcsPushTask))/]
[elseif (task.oclIsTypeOf(VcsCommitTask))]
[generateVcsCommitTask(task.oclAsType(VcsCommitTask))/]
[elseif (task.oclIsTypeOf(VcsTagTask))]
[generateVcsTagTask(task.oclAsType(VcsTagTask))/]
[elseif (task.oclIsTypeOf(VcsBranchTask))]
[generateVcsBranchTask(task.oclAsType(VcsBranchTask))/]
[elseif (task.oclIsTypeOf(ArtifactDownloaderTask))]
[generateArtifactDownloaderTask(task.oclAsType(ArtifactDownloaderTask))/]
[elseif (task.oclIsTypeOf(DockerBuildImageTask))]
[generateDockerBuildImageTask(task.oclAsType(DockerBuildImageTask))/]
[elseif (task.oclIsTypeOf(DockerRunContainerTask))]
[generateDockerRunContainerTask(task.oclAsType(DockerRunContainerTask))/]
[elseif (task.oclIsTypeOf(DockerPushImageTask))]
[generateDockerPushImageTask(task.oclAsType(DockerPushImageTask))/]
[elseif (task.oclIsTypeOf(DockerPullImageTask))]
[generateDockerPullImageTask(task.oclAsType(DockerPullImageTask))/]
[elseif (task.oclIsTypeOf(ScpTask))]
[generateScpTask(task.oclAsType(ScpTask))/]
[elseif (task.oclIsTypeOf(TestParserTask))]
[generateTestParserTask(task.oclAsType(TestParserTask))/]
[elseif (task.oclIsTypeOf(AnyTask))]
[generateAnyTask(task.oclAsType(AnyTask))/]
[/if]
[/template]

[template public generateInjectVariablesTask(task : InjectVariablesTask)]
    - inject-variables:
        path: [generateExpression(task.path)/]
[if (not task.namespace.oclIsUndefined())]
        namespace: [generateExpression(task.namespace)/]
[/if]
        scope: [task.scope/]
[generateTaskCommon(task)/]
[/template]

[template public generateScriptTask(task : ScriptTask)]
    - script:
[if (not task.interpreter.oclIsUndefined())]
        interpreter: [generateExpression(task.interpreter)/]
[/if]
[if (not task.inlineBody.oclIsUndefined())]
        body: [generateExpression(task.inlineBody)/]
[/if]
[if (not task.fileFromPath.oclIsUndefined())]
        file: [generateExpression(task.fileFromPath)/]
[/if]
[if (task.arguments->notEmpty())]
        arguments:
[for (argument : Expression | task.arguments)]
          - [generateExpression(argument)/]
[/for]
[/if]
[if (task.environmentVariables->notEmpty())]
        environment:
[for (variableAssignment : VariableAssignment | task.environmentVariables)]
          [generateVariableAssignment(variableAssignment)/]
[/for]
[/if]
[if (not task.workingSubdirectory.oclIsUndefined())]
        working-dir: [generateExpression(task.workingSubdirectory)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateMavenTask(task : MavenTask)]
    - maven:
        goal: [generateExpression(task.goal)/]
[if (not task.hasTests.oclIsUndefined())]
        tests: [task.hasTests/]
[/if]
        version: [task.mavenVersion/]
[if (not task.jdk.oclIsUndefined())]
        jdk: [generateExpression(task.jdk)/]
[/if]
[if (not task.executableLabel.oclIsUndefined())]
        executable-label: [generateExpression(task.executableLabel)/]
[/if]
[if (task.environmentVariables->notEmpty())]
        environment:
[for (variableAssignment : VariableAssignment | task.environmentVariables)]
          [generateVariableAssignment(variableAssignment)/]
[/for]
[/if]
[if (not task.workingSubdirectory.oclIsUndefined())]
        working-dir: [generateExpression(task.workingSubdirectory)/]
[/if]
[if (not task.testResultsPath.oclIsUndefined())]
        test-results: [generateExpression(task.testResultsPath)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateNUnitRunnerTask(task : NUnitRunnerTask)]
    - nunit:
        executable: [generateExpression(task.executable)/]
        version: [task.nUnitVersion/]
[if (not task.nUnitTestFiles.oclIsUndefined())]
        test-files: [generateExpression(task.nUnitTestFiles)/]
[/if]
[if (not task.resultFilename.oclIsUndefined())]
        result-file: [generateExpression(task.resultFilename)/]
[/if]
[if (not task.testsToRun.oclIsUndefined())]
        tests: [generateExpression(task.testsToRun)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateCheckoutItem(checkoutItem : CheckoutItem)]
          - default: [checkoutItem.defaultRepository/]
[if (not checkoutItem.repository.oclIsUndefined())]
            repository: [generateExpression(checkoutItem.repository)/]
[/if]
[if (not checkoutItem.path.oclIsUndefined())]
            path: [generateExpression(checkoutItem.path)/]
[/if]
[/template]

[template public generateVcsCheckoutTask(task : VcsCheckoutTask)]
    - checkout:
        force-clean-build: [task.cleanCheckout/]
[if (task.checkoutItems->notEmpty())]
        items:
[for (checkoutItem : CheckoutItem | task.checkoutItems)]
[generateCheckoutItem(checkoutItem)/]
[/for]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateVcsPushTask(task : VcsPushTask)]
    - vcs-push:
[if (not task.repository.oclIsUndefined())]
        repository: [generateExpression(task.repository)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateVcsCommitTask(task : VcsCommitTask)]
    - vcs-commit:
        default-repository: [task.defaultRepository/]
[if (not task.repository.oclIsUndefined())]
        repository: [generateExpression(task.repository)/]
[/if]
[if (not task.commitMessage.oclIsUndefined())]
        message: [generateExpression(task.commitMessage)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateVcsTagTask(task : VcsTagTask)]
    - vcs-tag:
        default-repository: [task.defaultRepository/]
[if (not task.repository.oclIsUndefined())]
        repository: [generateExpression(task.repository)/]
[/if]
[if (not task.tagName.oclIsUndefined())]
        tag-name: [generateExpression(task.tagName)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateVcsBranchTask(task : VcsBranchTask)]
    - vcs-branch:
[if (not task.repository.oclIsUndefined())]
        repository: [generateExpression(task.repository)/]
[/if]
[if (not task.branchName.oclIsUndefined())]
        branch-name: [generateExpression(task.branchName)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateDownloadItem(downloadItem : DownloadItem)]
[if (downloadItem.allArtifacts)]
          - destination: [if (not downloadItem.path.oclIsUndefined())][generateExpression(downloadItem.path)/][else]/[/if]
[else]
          - name: [generateExpression(downloadItem.artifact)/]
[if (not downloadItem.path.oclIsUndefined())]
            destination: [generateExpression(downloadItem.path)/]
[/if]
[/if]
[/template]

[template public generateArtifactDownloaderTask(task : ArtifactDownloaderTask)]
    - artifact-download:
[if (not task.sourcePlan.oclIsUndefined())]
        source-plan: [generatePlanIdentifier(task.sourcePlan)/]
[/if]
[if (task.artifacts->notEmpty())]
        artifacts:
[for (downloadItem : DownloadItem | task.artifacts)]
[generateDownloadItem(downloadItem)/]
[/for]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateDockerBuildImageTask(task : DockerBuildImageTask)]
    - docker-build:
        image-name: [generateExpression(task.imageName)/]
[if (not task.dockerfileLocation.oclIsUndefined())]
        dockerfile: [generateExpression(task.dockerfileLocation)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateDockerRunContainerTask(task : DockerRunContainerTask)]
    - docker-run:
        image-name: [generateExpression(task.imageName)/]
[if (not task.containerName.oclIsUndefined())]
        container-name: [generateExpression(task.containerName)/]
[/if]
[if (not task.containerWorkingDirectory.oclIsUndefined())]
        working-dir: [generateExpression(task.containerWorkingDirectory)/]
[/if]
        detach: [task.detachContainer/]
        wait-to-start: [task.waitToStart/]
[if (not task.serviceURLPattern.oclIsUndefined())]
        service-url: [generateExpression(task.serviceURLPattern)/]
[/if]
[if (task.portMappings->notEmpty())]
        ports:
[for (portMapping : Expression | task.portMappings)]
          - [generateExpression(portMapping)/]
[/for]
[/if]
[if (task.volumeMappings->notEmpty())]
        volumes:
[for (volumeMapping : Expression | task.volumeMappings)]
          - [generateExpression(volumeMapping)/]
[/for]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateDockerPushImageTask(task : DockerPushImageTask)]
    - docker-push:
        image: [generateExpression(task.customRegistryImage)/]
[generateTaskCommon(task)/]
[/template]

[template public generateDockerPullImageTask(task : DockerPullImageTask)]
    - docker-pull:
        image: [generateExpression(task.customRegistryImage)/]
[generateTaskCommon(task)/]
[/template]

[template public generateArtifactItemField(artifactItem : ArtifactItem)]
[if (artifactItem.allArtifacts)]
        from: all-artifacts
[else]
        from: [generateExpression(artifactItem.artifact)/]
[/if]
[/template]

[template public generateScpTask(task : ScpTask)]
    - scp:
        host: [generateExpression(task.host)/]
[if (not task.username.oclIsUndefined())]
        username: [generateExpression(task.username)/]
[/if]
[if (not task.password.oclIsUndefined())]
        password: [generateExpression(task.password)/]
[/if]
[if (not task.fromArtifact.oclIsUndefined())]
[generateArtifactItemField(task.fromArtifact)/]
[/if]
[if (not task.toRemotePath.oclIsUndefined())]
        to: [generateExpression(task.toRemotePath)/]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateTestParserTask(task : TestParserTask)]
    - test-parser:
        type: [task.type/]
[if (task.testResults->notEmpty())]
        test-results:
[for (testResult : Expression | task.testResults)]
          - [generateExpression(testResult)/]
[/for]
[/if]
[if (task.resultDirectories->notEmpty())]
        result-directories:
[for (resultDirectory : Expression | task.resultDirectories)]
          - [generateExpression(resultDirectory)/]
[/for]
[/if]
        pick-up-outside-build: [task.pickUpTestResultsOutsideBuild/]
[generateTaskCommon(task)/]
[/template]

[template public generateAnyTask(task : AnyTask)]
    - any-task:
        module: [generateExpression(task.module)/]
[if (task.configuration->notEmpty())]
        configuration:
[for (variableAssignment : VariableAssignment | task.configuration)]
          [generateVariableAssignment(variableAssignment)/]
[/for]
[/if]
[generateTaskCommon(task)/]
[/template]

[template public generateArtifactItem(artifact : Artifact)]
    - name: [artifact.name/]
[if (not artifact.location.oclIsUndefined())]
      location: [generateExpression(artifact.location)/]
[/if]
[if (not artifact.copyPattern.oclIsUndefined())]
      pattern: [generateExpression(artifact.copyPattern)/]
[/if]
      shared: [artifact.shared/]
[/template]

[template public generateRequirementItem(requirement : Requirement)]
    - key: [requirement.key/]
      match-type: [requirement.matchType/]
[if (not requirement.matchValue.oclIsUndefined())]
      match-value: [generateExpression(requirement.matchValue)/]
[/if]
[/template]

[template public generateJobDockerConfiguration(dockerConfiguration : DockerConfiguration)]
    image: [generateExpression(dockerConfiguration.image)/]
[/template]

[template public generateJobPluginConfigurationItem(pluginConfiguration : PluginConfiguration)]
    - configuration:
[for (variableAssignment : VariableAssignment | pluginConfiguration.configuration)]
        [generateVariableAssignment(variableAssignment)/]
[/for]
[/template]

[template public generatePlanPluginConfigurationItem(pluginConfiguration : PluginConfiguration)]
  - configuration:
[for (variableAssignment : VariableAssignment | pluginConfiguration.configuration)]
      [generateVariableAssignment(variableAssignment)/]
[/for]
[/template]

[template public generateJob(job : Job)]
[job.name/]:
[if (not job.key.oclIsUndefined())]
  key: [job.key/]
[/if]
  tasks:
[for (task : AbstractTask | job.tasks)]
[generateTaskItem(task)/]
[/for]
[if (job.finalTasks->notEmpty())]
  final-tasks:
[for (task : AbstractTask | job.finalTasks)]
[generateTaskItem(task)/]
[/for]
[/if]
[if (job.artifacts->notEmpty())]
  artifacts:
[for (artifact : Artifact | job.artifacts)]
[generateArtifactItem(artifact)/]
[/for]
[/if]
[if (job.artifactSubscriptions->notEmpty())]
  artifact-subscriptions:
[for (expression : Expression | job.artifactSubscriptions)]
    - [generateExpression(expression)/]
[/for]
[/if]
[if (job.requirements->notEmpty())]
  requirements:
[for (requirement : Requirement | job.requirements)]
[generateRequirementItem(requirement)/]
[/for]
[/if]
[if (not job.cleanWorkingDirectory.oclIsUndefined())]
  clean-working-dir: [job.cleanWorkingDirectory/]
[/if]
[if (not job.dockerConfiguration.oclIsUndefined())]
  docker:
[generateJobDockerConfiguration(job.dockerConfiguration)/]
[/if]
[if (job.pluginConfigurations->notEmpty())]
  other:
[for (pluginConfiguration : PluginConfiguration | job.pluginConfigurations)]
[generateJobPluginConfigurationItem(pluginConfiguration)/]
[/for]
[/if]

[/template]

[template public generateStageHeader(stage : Stage)]
  - [stage.name/]:
[if (not stage.description.oclIsUndefined())]
      description: [generateExpression(stage.description)/]
[/if]
[if (stage.manual)]
      manual: true
[/if]
[if (stage.isFinal)]
      final: true
[/if]
      jobs:
[for (job : Job | stage.jobs)]
        - [job.name/]
[/for]
[/template]

[template public generateScheduleSpec(scheduleSpec : ScheduleSpec)]
type: [scheduleSpec.scheduleType/]
[if (not scheduleSpec.interval.oclIsUndefined())]
interval: [generateExpression(scheduleSpec.interval)/]
[/if]
[if (not scheduleSpec.time.oclIsUndefined())]
time: [generateExpression(scheduleSpec.time)/]
[/if]
[if (scheduleSpec.daysOfWeek->notEmpty())]
days:
[for (dayOfWeek : DayOfWeek | scheduleSpec.daysOfWeek)]
  - [dayOfWeek/]
[/for]
[/if]
[if (not scheduleSpec.dayOfMonth.oclIsUndefined())]
day-of-month: [generateExpression(scheduleSpec.dayOfMonth)/]
[/if]
[if (not scheduleSpec.cronExpression.oclIsUndefined())]
cron: [generateExpression(scheduleSpec.cronExpression)/]
[/if]
[/template]

[template public generateAllOtherTriggerCondition(triggerCondition : AllOtherTriggerCondition)]
        - all-other:
[for (variableAssignment : VariableAssignment | triggerCondition.configuration)]
            [generateVariableAssignment(variableAssignment)/]
[/for]
[/template]

[template public generatePlansGreenTriggerCondition(triggerCondition : PlansGreenTriggerCondition)]
        - plans-green:
[for (planIdentifier : PlanIdentifier | triggerCondition.plans)]
            - [generatePlanIdentifier(planIdentifier)/]
[/for]
[/template]

[template public generateTriggerConditionItem(triggerCondition : TriggerCondition)]
[if (triggerCondition.oclIsTypeOf(AllOtherTriggerCondition))]
[generateAllOtherTriggerCondition(triggerCondition.oclAsType(AllOtherTriggerCondition))/]
[elseif (triggerCondition.oclIsTypeOf(PlansGreenTriggerCondition))]
[generatePlansGreenTriggerCondition(triggerCondition.oclAsType(PlansGreenTriggerCondition))/]
[/if]
[/template]

[template public generateRepositoryPollingTrigger(trigger : RepositoryPollingTrigger)]
  - repository-polling:
      [generateScheduleSpec(trigger)/]
[if (trigger.conditions->notEmpty())]
      conditions:
[for (triggerCondition : TriggerCondition | trigger.conditions)]
[generateTriggerConditionItem(triggerCondition)/]
[/for]
[/if]
[/template]

[template public generateScheduledTrigger(trigger : ScheduledTrigger)]
  - scheduled:
      [generateScheduleSpec(trigger)/]
[/template]

[template public generateScheduledDeploymentTrigger(trigger : ScheduledDeploymentTrigger)]
  - scheduled-deployment:
      [generateScheduleSpec(trigger)/]
[if (not trigger.artifactBranch.oclIsUndefined())]
      artifact-branch: [generateExpression(trigger.artifactBranch)/]
[/if]
[/template]

[template public generateRemoteTrigger(trigger : RemoteTrigger)]
  - remote:
[if (trigger.triggerIPAddresses->notEmpty())]
      ip-addresses:
[for (ipAddress : Expression | trigger.triggerIPAddresses)]
        - [generateExpression(ipAddress)/]
[/for]
[/if]
[/template]

[template public generateAfterSuccessfulBuildPlanTrigger(trigger : AfterSuccessfulBuildPlanTrigger)]
  - after-successful-build-plan:
[if (not trigger.triggerByBranch.oclIsUndefined())]
      trigger-by-branch: [generateExpression(trigger.triggerByBranch)/]
[/if]
[/template]

[template public generateAfterSuccessfulStageTrigger(trigger : AfterSuccessfulStageTrigger)]
  - after-successful-stage:
      stage-name: [generateExpression(trigger.stageName)/]
[if (not trigger.triggerByBranch.oclIsUndefined())]
      trigger-by-branch: [generateExpression(trigger.triggerByBranch)/]
[/if]
[/template]

[template public generateAfterSuccessfulDeploymentTrigger(trigger : AfterSuccessfulDeploymentTrigger)]
  - after-successful-deployment:
      environment-name: [generateExpression(trigger.environmentName)/]
[if (not trigger.triggerByBranch.oclIsUndefined())]
      trigger-by-branch: [generateExpression(trigger.triggerByBranch)/]
[/if]
[/template]

[template public generateAfterDeploymentTrigger(trigger : AfterDeploymentTrigger)]
  - after-deployment:
      deployment-project: [generateExpression(trigger.deploymentProject)/]
[if (not trigger.environment.oclIsUndefined())]
      environment: [generateExpression(trigger.environment)/]
[/if]
      any-environment: [trigger.anyEnvironment/]
[/template]

[template public generateTriggerItem(trigger : Trigger)]
[if (trigger.oclIsTypeOf(RepositoryPollingTrigger))]
[generateRepositoryPollingTrigger(trigger.oclAsType(RepositoryPollingTrigger))/]
[elseif (trigger.oclIsTypeOf(ScheduledDeploymentTrigger))]
[generateScheduledDeploymentTrigger(trigger.oclAsType(ScheduledDeploymentTrigger))/]
[elseif (trigger.oclIsTypeOf(ScheduledTrigger))]
[generateScheduledTrigger(trigger.oclAsType(ScheduledTrigger))/]
[elseif (trigger.oclIsTypeOf(RemoteTrigger))]
[generateRemoteTrigger(trigger.oclAsType(RemoteTrigger))/]
[elseif (trigger.oclIsTypeOf(AfterSuccessfulStageTrigger))]
[generateAfterSuccessfulStageTrigger(trigger.oclAsType(AfterSuccessfulStageTrigger))/]
[elseif (trigger.oclIsTypeOf(AfterSuccessfulBuildPlanTrigger))]
[generateAfterSuccessfulBuildPlanTrigger(trigger.oclAsType(AfterSuccessfulBuildPlanTrigger))/]
[elseif (trigger.oclIsTypeOf(AfterSuccessfulDeploymentTrigger))]
[generateAfterSuccessfulDeploymentTrigger(trigger.oclAsType(AfterSuccessfulDeploymentTrigger))/]
[elseif (trigger.oclIsTypeOf(AfterDeploymentTrigger))]
[generateAfterDeploymentTrigger(trigger.oclAsType(AfterDeploymentTrigger))/]
[/if]
[/template]

[template public generateDependencies(dependencies : Dependencies)]
  require-all-stages-passing: [dependencies.requireAllStagesPassing/]
[if (dependencies.childPlans->notEmpty())]
  child-plans:
[for (planIdentifier : PlanIdentifier | dependencies.childPlans)]
    - [generatePlanIdentifier(planIdentifier)/]
[/for]
[/if]
[/template]

[template public generateSshPrivateKeyAuthentication(authentication : SshPrivateKeyAuthentication)]
    authentication:
      type: ssh-private-key
      private-key: [generateExpression(authentication.privateKey)/]
[if (not authentication.passphrase.oclIsUndefined())]
      passphrase: [generateExpression(authentication.passphrase)/]
[/if]
[/template]

[template public generateUserPasswordAuthentication(authentication : UserPasswordAuthentication)]
    authentication:
      type: user-password
      username: [generateExpression(authentication.username)/]
      password: [generateExpression(authentication.password)/]
[/template]

[template public generateAuthentication(authentication : Authentication)]
[if (authentication.oclIsTypeOf(SshPrivateKeyAuthentication))]
[generateSshPrivateKeyAuthentication(authentication.oclAsType(SshPrivateKeyAuthentication))/]
[elseif (authentication.oclIsTypeOf(UserPasswordAuthentication))]
[generateUserPasswordAuthentication(authentication.oclAsType(UserPasswordAuthentication))/]
[/if]
[/template]

[template public generateGitRepository(repository : GitRepository)]
  - name: [repository.name/]
    type: git
    url: [generateExpression(repository.url)/]
[if (not repository.branch.oclIsUndefined())]
    branch: [generateExpression(repository.branch)/]
[/if]
[if (not repository.authentication.oclIsUndefined())]
[generateAuthentication(repository.authentication)/]
[/if]
[/template]

[template public generateBitbucketServerRepository(repository : BitbucketServerRepository)]
  - name: [repository.name/]
    type: bitbucket-server
[if (not repository.server.oclIsUndefined())]
    server: [generateExpression(repository.server)/]
[/if]
[if (not repository.projectKey.oclIsUndefined())]
    project-key: [generateExpression(repository.projectKey)/]
[/if]
[if (not repository.sshCloneUrl.oclIsUndefined())]
    ssh-clone-url: [generateExpression(repository.sshCloneUrl)/]
[/if]
[if (not repository.repositorySlug.oclIsUndefined())]
    repository-slug: [generateExpression(repository.repositorySlug)/]
[/if]
[if (not repository.branch.oclIsUndefined())]
    branch: [generateExpression(repository.branch)/]
[/if]
[if (not repository.sshPrivateKey.oclIsUndefined())]
    ssh-private-key: [generateExpression(repository.sshPrivateKey)/]
[/if]
[if (not repository.sshPublicKey.oclIsUndefined())]
    ssh-public-key: [generateExpression(repository.sshPublicKey)/]
[/if]
[/template]

[template public generateAnyVcsRepository(repository : AnyVcsRepository)]
  - name: [repository.name/]
    type: any-vcs
    module: [generateExpression(repository.module)/]
[if (repository.serverConfiguration->notEmpty())]
    server-configuration:
[for (variableAssignment : VariableAssignment | repository.serverConfiguration)]
      [generateVariableAssignment(variableAssignment)/]
[/for]
[/if]
[/template]

[template public generateRepositoryItem(repository : Repository)]
[if (repository.oclIsTypeOf(GitRepository))]
[generateGitRepository(repository.oclAsType(GitRepository))/]
[elseif (repository.oclIsTypeOf(BitbucketServerRepository))]
[generateBitbucketServerRepository(repository.oclAsType(BitbucketServerRepository))/]
[elseif (repository.oclIsTypeOf(AnyVcsRepository))]
[generateAnyVcsRepository(repository.oclAsType(AnyVcsRepository))/]
[/if]
[/template]

[template public generateBranchIntegration(branchIntegration : BranchIntegration)]
  integration:
[if (not branchIntegration.integrationBranchKey.oclIsUndefined())]
    branch: [generateExpression(branchIntegration.integrationBranchKey)/]
[/if]
    gatekeeper: [branchIntegration.gatekeeper/]
    push-on-successful-build: [branchIntegration.pushOnSuccessfulBuild/]
[/template]

[template public generateBranchManagement(planBranchManagement : PlanBranchManagement)]
  create-for-vcs-branch-matching: [generateExpression(planBranchManagement.createForVcsBranchMatching)/]
[if (not planBranchManagement.triggerBuildsLikeParentPlan.oclIsUndefined())]
  trigger-builds-like-parent-plan: [planBranchManagement.triggerBuildsLikeParentPlan/]
[/if]
[if (not planBranchManagement.branchIntegration.oclIsUndefined())]
[generateBranchIntegration(planBranchManagement.branchIntegration)/]
[/if]
[/template]

[template public generateNotificationType(notificationType : NotificationType) post (trim())]
[if (notificationType.oclIsTypeOf(DeploymentFailedNotification))]deployment-failed[elseif (notificationType.oclIsTypeOf(DeploymentFinishedNotification))]deployment-finished[elseif (notificationType.oclIsTypeOf(PlanStatusChangedNotification))]plan-status-changed[elseif (notificationType.oclIsTypeOf(JobFailedNotification))]job-failed[elseif (notificationType.oclIsTypeOf(PlanCompletedNotification))]plan-completed[elseif (notificationType.oclIsTypeOf(XFailedChainsNotification))]x-failed-chains ([notificationType.oclAsType(XFailedChainsNotification).numberOfFailures/])[/if]
[/template]

[template public generateRecipientItem(recipient : Recipient)]
[if (recipient.oclIsTypeOf(GroupRecipient))]
        - group: [generateExpression(recipient.oclAsType(GroupRecipient).group)/]
[elseif (recipient.oclIsTypeOf(EmailRecipient))]
        - email: [generateExpression(recipient.oclAsType(EmailRecipient).email)/]
[elseif (recipient.oclIsTypeOf(UserRecipient))]
        - user: [generateExpression(recipient.oclAsType(UserRecipient).user)/]
[elseif (recipient.oclIsTypeOf(ResponsibleRecipient))]
        - responsible: true
[elseif (recipient.oclIsTypeOf(WebhookRecipient))]
        - webhook:
            name: [generateExpression(recipient.oclAsType(WebhookRecipient).name)/]
            url: [generateExpression(recipient.oclAsType(WebhookRecipient).url)/]
[/if]
[/template]

[template public generateNotificationItem(notification : Notification)]
  - type: [generateNotificationType(notification.type)/]
[if (notification.recipients->notEmpty())]
    recipients:
[for (recipient : Recipient | notification.recipients)]
[generateRecipientItem(recipient)/]
[/for]
[/if]
[/template]

[template public generateConcurrentBuilds(concurrentBuilds : ConcurrentBuilds)]
[if (not concurrentBuilds.maximumNumberOfConcurrentBuilds.oclIsUndefined())]
  max-concurrent-builds: [concurrentBuilds.maximumNumberOfConcurrentBuilds/]
[else]
  max-concurrent-builds: unlimited
[/if]
[/template]

[template public generateElement(plan : Plan)]
[comment @main/]
[file ('bamboo-specs.yaml', false, 'UTF-8')]
---
version: 2
plan:
  project-key: [plan.projectKey/]
  name: [generateExpression(plan.name)/]
  key: [plan.planKey/]
[if (not plan.description.oclIsUndefined())]
  description: [generateExpression(plan.description)/]
[/if]
  enabled: [plan.enabled/]

stages:
[for (stage : Stage | plan.stages)]
[generateStageHeader(stage)/]
[/for]

[for (stage : Stage | plan.stages)]
[for (job : Job | stage.jobs)]
[generateJob(job)/]
[/for]
[/for]
[if (plan.triggers->notEmpty())]
triggers:
[for (trigger : Trigger | plan.triggers)]
[generateTriggerItem(trigger)/]
[/for]

[/if]
[if (plan.variables->notEmpty())]
variables:
[for (variableAssignment : VariableAssignment | plan.variables)]
  [generateVariableAssignment(variableAssignment)/]
[/for]

[/if]
[if (not plan.dependencies.oclIsUndefined())]
dependencies:
[generateDependencies(plan.dependencies)/]

[/if]
[if (plan.planRepositories->notEmpty())]
repositories:
[for (repository : Repository | plan.planRepositories)]
[generateRepositoryItem(repository)/]
[/for]

[/if]
[if (plan.linkedRepositories->notEmpty())]
linked-repositories:
[for (expression : Expression | plan.linkedRepositories)]
  - [generateExpression(expression)/]
[/for]

[/if]
[if (not plan.planBranchManagement.oclIsUndefined())]
branches:
[generateBranchManagement(plan.planBranchManagement)/]

[/if]
[if (plan.notifications->notEmpty())]
notifications:
[for (notification : Notification | plan.notifications)]
[generateNotificationItem(notification)/]
[/for]

[/if]
[if (not plan.concurrentBuilds.oclIsUndefined())]
concurrent-builds:
[generateConcurrentBuilds(plan.concurrentBuilds)/]

[/if]
[if (plan.pluginConfigurations->notEmpty())]
other:
[for (pluginConfiguration : PluginConfiguration | plan.pluginConfigurations)]
[generatePlanPluginConfigurationItem(pluginConfiguration)/]
[/for]
[/if]
[/file]
[/template]