-- @nsURI PIM=pimMM=http://www.mddoai.com/mddoai/metamodel/pim
-- @nsURI BambooMM=bambooMM=http://www.mddoai.com/mddoai/metamodel/bamboo

module pim2bamboo;

create OUT : BambooMM from IN : PIM;

rule Pipeline2Plan {
	from
		pipeline : PIM!Pipeline
	to
		plan : BambooMM!Plan(
			name <-
				if pipeline.name.oclIsUndefined() then
					'pipeline'
				else
					pipeline.name
				endif,
			project <- thisModule.CreateProject(pipeline),
			variables <- pipeline.environmentVariables->collect(assignment | thisModule.Assignment2PlanVariable(assignment)),
			triggers <- pipeline.triggers,
			stages <-
				let allJobs : Sequence(PIM!Job) = thisModule.getAllJobs(pipeline.jobStreams) in
				thisModule.sortedLevels(allJobs)->collect(level | thisModule.JobGroup2Stage(thisModule.jobsAtLevel(allJobs, level), level))
		)
}

lazy rule CreateProject {
	from
		pipeline : PIM!Pipeline
	to
		project : BambooMM!Project(
			name <-
				if pipeline.name.oclIsUndefined() then
					'default-project'
				else
					pipeline.name + '-project'
				endif
		)
}

lazy rule Assignment2PlanVariable {
	from
		assignment : PIM!Assignment
	to
		variable : BambooMM!PlanVariable(
			name <- assignment.key.name,
			value <- assignment.value.expr2String()
		)
}

lazy rule JobGroup2Stage {
	from
		jobsInLevel : Sequence(PIM!Job),
		level : Integer
	to
		stage : BambooMM!Stage(
			name <- 'stage-' + level.toString(),
			jobs <- jobsInLevel
		)
}

abstract rule Job2Job {
	from
		cicdJob : PIM!Job
	to
		bambooJob : BambooMM!Job(
			name <- cicdJob.id,
			agent <-
				if cicdJob.agent.oclIsUndefined() then
					OclUndefined
				else
					cicdJob.agent.toBambooAgent()
				endif,
			requirements <-
				if cicdJob.agent.oclIsUndefined() then
					Sequence{}
				else if cicdJob.agent.oclIsTypeOf(PIM!CustomAgent) then
					cicdJob.agent.labels->collect(label | thisModule.Label2Requirement(label))
				else
					Sequence{}
				endif
				endif,
			artifacts <- cicdJob.jobArtifacts()
		)
}

rule ScriptJob2Job extends Job2Job {
	from
		cicdJob : PIM!ScriptJob
	to
		bambooJob : BambooMM!Job(
			tasks <- thisModule.flattenSteps(cicdJob.steps)->collect(step | thisModule.dispatchStepToTasks(step))->flatten()
		)
}

rule PipelineCallJob2Job extends Job2Job {
	from
		cicdJob : PIM!PipelineCallJob
	to
		bambooJob : BambooMM!Job(
			tasks <- Sequence{thisModule.PipelineCallJob2ScriptTask(cicdJob)}
		)
}

lazy rule PipelineCallJob2ScriptTask {
	from
		job : PIM!PipelineCallJob
	to
		task : BambooMM!ScriptTask(
			name <- job.name,
			script <- 'echo "Triggering pipeline: ' + job.pipelinePath.expr2String() + '"',
			description <- 'Auto-generated placeholder for pipeline call job'
		)
}

lazy rule Label2Requirement {
	from
		label : PIM!Expression
	to
		requirement : BambooMM!Requirement(
			capability <- label.expr2String()
		)
}

lazy rule CreateAgent {
	from
		name : String
	to
		agent : BambooMM!Agent(
			name <- name
		)
}

helper context PIM!Agent def : toBambooAgent() : BambooMM!Agent =
	OclUndefined;

helper context PIM!CustomAgent def : toBambooAgent() : BambooMM!Agent =
	thisModule.CreateAgent(
		self.labels->iterate(l; acc : String = '' |
			if acc = '' then
				l.expr2String()
			else
				acc + ',' + l.expr2String()
			endif
		)
	);

helper context PIM!LinuxAgent def : toBambooAgent() : BambooMM!Agent =
	thisModule.CreateAgent(self.linuxImageName());

helper context PIM!LinuxAgent def : linuxImageName() : String =
	if self.container.oclIsUndefined() then
		if self.image.oclIsUndefined() then
			'linux'
		else
			self.image.expr2String()
		endif
	else
		self.container.image.expr2String()
	endif;

helper context PIM!WindowsAgent def : toBambooAgent() : BambooMM!Agent =
	thisModule.CreateAgent(
		if self.image.oclIsUndefined() then
			'windows'
		else
			self.image.expr2String()
		endif
	);

helper context PIM!MacOSAgent def : toBambooAgent() : BambooMM!Agent =
	thisModule.CreateAgent(
		if self.image.oclIsUndefined() then
			'macos'
		else
			self.image.expr2String()
		endif
	);

helper context PIM!Job def : jobArtifacts() : Sequence(BambooMM!Artifact) =
	Sequence{};

helper context PIM!ScriptJob def : jobArtifacts() : Sequence(BambooMM!Artifact) =
	thisModule.flattenSteps(self.steps)->collect(step | thisModule.dispatchStepToArtifacts(step))->flatten();

lazy rule Artifact2Artifact {
	from
		step : PIM!Artifact
	to
		artifact : BambooMM!Artifact(
			name <-
				if step.artifactName.oclIsUndefined() then
					'artifact'
				else
					step.artifactName.expr2String()
				endif,
			location <-
				if step.includePaths->notEmpty() then
					step.includePaths->first().expr2String()
				else
					'.'
				endif
		)
}

helper def : dispatchStepToArtifacts(step : PIM!Step) : Sequence(BambooMM!Artifact) =
	if step.oclIsTypeOf(PIM!Artifact) then
		if step.store then
			Sequence{thisModule.Artifact2Artifact(step)}
		else
			Sequence{}
		endif
	else
		Sequence{}
	endif;

helper def : dispatchStepToTasks(step : PIM!Step) : Sequence(BambooMM!Task) =
	if step.oclIsTypeOf(PIM!Checkout) then
		Sequence{}
	else if step.oclIsTypeOf(PIM!Artifact) then
		Sequence{}
	else if step.oclIsTypeOf(PIM!Command) then
		Sequence{thisModule.Command2ScriptTask(step)}
	else if step.oclIsTypeOf(PIM!Plugin) then
		Sequence{thisModule.dispatchPlugin(step)}
	else if step.oclIsTypeOf(PIM!Cache) then
		Sequence{thisModule.Cache2ScriptTask(step)}
	else
		Sequence{}
	endif
	endif
	endif
	endif
	endif;

lazy rule Command2ScriptTask {
	from
		step : PIM!Command
	to
		task : BambooMM!ScriptTask(
			name <- step.name,
			script <- step.program.expr2String(),
			description <- OclUndefined
		)
}

lazy rule Cache2ScriptTask {
	from
		step : PIM!Cache
	to
		task : BambooMM!ScriptTask(
			name <- step.name,
			script <- 'echo "Cache step: ' + step.cacheName.expr2String() + '"',
			description <- 'Auto-generated placeholder for cache step'
		)
}

helper def : kwargValue(kwargs : Sequence(PIM!Assignment), keyName : String) : String =
	let matches : Sequence(PIM!Assignment) =
		kwargs->iterate(a; acc : Sequence(PIM!Assignment) = Sequence{} |
			if a.key.name = keyName then
				acc->union(Sequence{a})
			else
				acc
			endif
		)
	in
	if matches->isEmpty() then
		''
	else
		matches->first().value.expr2String()
	endif;

helper def : dispatchPlugin(step : PIM!Plugin) : BambooMM!Task =
	if step.pluginName = 'clean-working-directory' then
		thisModule.Plugin2CleanWorkingDirectoryTask(step)
	else if step.pluginName = 'inject-variables' then
		thisModule.Plugin2InjectVariablesTask(step)
	else if step.pluginName = 'maven' then
		thisModule.Plugin2MavenTask(step)
	else if step.pluginName = 'nunit-runner' then
		thisModule.Plugin2NUnitRunnerTask(step)
	else if step.pluginName = 'docker-cli' then
		thisModule.Plugin2DockerCLITask(step)
	else if step.pluginName = 'docker-build' then
		thisModule.Plugin2DockerBuildImageTask(step)
	else if step.pluginName = 'docker-run' then
		thisModule.Plugin2DockerRunContainerTask(step)
	else if step.pluginName = 'docker-push' then
		thisModule.Plugin2DockerPushImageTask(step)
	else if step.pluginName = 'docker-pull' then
		thisModule.Plugin2DockerPullImageTask(step)
	else if step.pluginName = 'artifact-downloader' then
		thisModule.Plugin2ArtifactDownloaderTask(step)
	else if step.pluginName = 'junit-parser' then
		thisModule.Plugin2JUnitParserTask(step)
	else if step.pluginName = 'testng-parser' then
		thisModule.Plugin2TestNGParserTask(step)
	else if step.pluginName = 'mocha-parser' then
		thisModule.Plugin2MochaParserTask(step)
	else if step.pluginName = 'nunit-parser' then
		thisModule.Plugin2NUnitParserTask(step)
	else if step.pluginName = 'mstest-parser' then
		thisModule.Plugin2MSTestParserTask(step)
	else if step.pluginName = 'test-results-parser' then
		thisModule.Plugin2TestResultsParserTask(step)
	else
		thisModule.Plugin2GenericScriptTask(step)
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif
	endif;

lazy rule Plugin2CleanWorkingDirectoryTask {
	from
		step : PIM!Plugin
	to
		task : BambooMM!CleanWorkingDirectoryTask(
			name <- step.name
		)
}

lazy rule Plugin2InjectVariablesTask {
	from
		step : PIM!Plugin
	to
		task : BambooMM!InjectVariablesTask(
			name <- step.name,
			filePath <- thisModule.kwargValue(step.kwargs, 'filePath')
		)
}

