lazy rule Plugin2GenericScriptTask {
	from
		step : PIM!Plugin
	to
		task : BambooMM!ScriptTask(
			name <- step.name,
			script <- 'echo "Unsupported plugin: ' + step.pluginName + '"',
			description <- 'Auto-generated placeholder for unsupported plugin ' + step.pluginName
		)
}

helper def : flattenSteps(steps : Sequence(PIM!Step)) : Sequence(PIM!Step) =
	steps->iterate(step; acc : Sequence(PIM!Step) = Sequence{} |
		if step.oclIsTypeOf(PIM!ConditionalStep) then
			acc->union(thisModule.flattenConditionalStep(step))
		else
			acc->union(Sequence{step})
		endif
	);

helper def : flattenConditionalStep(step : PIM!Step) : Sequence(PIM!Step) =
	thisModule.flattenSteps(step.thenRun)->union(thisModule.flattenSteps(step.elseRun));

abstract rule Trigger2Trigger {
	from
		cicdTrigger : PIM!Trigger
	to
		bambooTrigger : BambooMM!Trigger
}

rule PushTrigger2RepositoryPollingTrigger extends Trigger2Trigger {
	from
		cicdTrigger : PIM!PushTrigger
	to
		bambooTrigger : BambooMM!RepositoryPollingTrigger(
			pollInterval <- 3,
			schedule <- thisModule.CreatePeriodicPollSchedule(cicdTrigger)
		)
}

lazy rule CreatePeriodicPollSchedule {
	from
		cicdTrigger : PIM!PushTrigger
	to
		schedule : BambooMM!PeriodicPollSchedule(
			interval <- 3,
			unit <- #minutes
		)
}

rule ScheduledTrigger2ScheduledTrigger extends Trigger2Trigger {
	from
		cicdTrigger : PIM!ScheduledTrigger
	to
		bambooTrigger : BambooMM!ScheduledTrigger(
			schedule <- thisModule.CreateCronTriggerSchedule(cicdTrigger)
		)
}

lazy rule CreateCronTriggerSchedule {
	from
		cicdTrigger : PIM!ScheduledTrigger
	to
		schedule : BambooMM!CronTriggerSchedule(
			expression <- cicdTrigger.crons->first()
		)
}

helper def : getAllJobs(jobStreams : Sequence(PIM!Job)) : Sequence(PIM!Job) =
	let next : Sequence(PIM!Job) =
		jobStreams->iterate(jobStream; acc : Sequence(Sequence(PIM!Job)) = Sequence{} |
			acc.append(jobStream.next)
		)->flatten()->asSet()->asSequence()
	in
	if next.isEmpty() then
		jobStreams
	else
		thisModule.getAllJobs(next)->prepend(jobStreams)->flatten()
	endif;

helper def : jobLevel(job : PIM!Job) : Integer =
	if job.previous->isEmpty() then
		0
	else
		job.previous->iterate(p; acc : Integer = 0 |
			if (thisModule.jobLevel(p) + 1) > acc then
				thisModule.jobLevel(p) + 1
			else
				acc
			endif
		)
	endif;

helper def : distinctLevels(jobs : Sequence(PIM!Job)) : Sequence(Integer) =
	jobs->collect(j | thisModule.jobLevel(j))->asSet()->asSequence();

helper def : sortLevelsHelper(levels : Sequence(Integer)) : Sequence(Integer) =
	if levels->isEmpty() then
		Sequence{}
	else
		let m : Integer = levels->iterate(l; acc : Integer = levels->first() |
			if l < acc then
				l
			else
				acc
			endif
		) in
		Sequence{m}->union(
			thisModule.sortLevelsHelper(
				levels->iterate(l; acc : Sequence(Integer) = Sequence{} |
					if l = m then
						acc
					else
						acc->union(Sequence{l})
					endif
				)
			)
		)
	endif;

helper def : sortedLevels(jobs : Sequence(PIM!Job)) : Sequence(Integer) =
	thisModule.sortLevelsHelper(thisModule.distinctLevels(jobs));

helper def : jobsAtLevel(jobs : Sequence(PIM!Job), level : Integer) : Sequence(PIM!Job) =
	jobs->iterate(j; acc : Sequence(PIM!Job) = Sequence{} |
		if thisModule.jobLevel(j) = level then
			acc->union(Sequence{j})
		else
			acc
		endif
	);

helper context PIM!Expression def : expr2String() : String =
	'';

helper context PIM!Assignment def : expr2String() : String =
	self.key.name + '=' + self.value.expr2String();

helper context PIM!StringLiteral def : expr2String() : String =
	self.value;

helper context PIM!IntegerLiteral def : expr2String() : String =
	self.value.toString();

helper context PIM!DoubleLiteral def : expr2String() : String =
	self.value.toString();

helper context PIM!BooleanLiteral def : expr2String() : String =
	self.value.toString();

helper context PIM!VariableReference def : expr2String() : String =
	'${bamboo.' + self.reference.name + '}';

helper context PIM!Concat def : expr2String() : String =
	self.expressions->iterate(e; acc : String = '' |
		acc + e.expr2String()
	);

helper context PIM!DotOp def : expr2String() : String =
	self.lhs.expr2String() + '.' + self.rhs.expr2String();

helper context PIM!And def : expr2String() : String =
	self.lhs.expr2String() + ' && ' + self.rhs.expr2String();

helper context PIM!Or def : expr2String() : String =
	self.lhs.expr2String() + ' || ' + self.rhs.expr2String();

helper context PIM!EqualityOp def : expr2String() : String =
	self.lhs.expr2String() +
	(if self.op = #"==" then ' == ' else ' != ' endif) +
	self.rhs.expr2String();

helper context PIM!ComparisonOp def : expr2String() : String =
	self.lhs.expr2String() + ' ' +
	(if self.op = #">" then '>' else if self.op = #">=" then '>=' else if self.op = #"<" then '<' else '<=' endif endif endif) +
	' ' + self.rhs.expr2String();

helper context PIM!Negation def : expr2String() : String =
	'!' + self.rhs.expr2String();