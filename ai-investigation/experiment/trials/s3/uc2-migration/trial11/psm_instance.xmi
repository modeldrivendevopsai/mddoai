<?xml version="1.0" encoding="ASCII"?>
<bambooMM:Plan xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bambooMM="http://www.mddoai.com/mddoai/metamodel/bamboo">
  <name xsi:type="bambooMM:StringLiteral" value="fullstack-webapp"/>
  <stages name="Stage-install-deps">
    <jobs name="install-deps">
      <key xsi:type="bambooMM:StringLiteral" value="install-deps"/>
      <tasks xsi:type="bambooMM:GenericPluginTask">
        <moduleKey xsi:type="bambooMM:StringLiteral" value="com.atlassian.bamboo.plugins.cache:cache-task"/>
        <configuration>
          <key name="key"/>
          <value xsi:type="bambooMM:StringLiteral" value="${CI_COMMIT_REF_SLUG}-node-modules"/>
        </configuration>
        <configuration>
          <key name="path"/>
          <value xsi:type="bambooMM:StringLiteral" value="node_modules/"/>
        </configuration>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm ci --prefer-offline"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="cd frontend &amp;&amp; npm ci --prefer-offline"/>
      </tasks>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="node:20-alpine"/>
      </requirements>
    </jobs>
  </stages>
  <stages name="Stage-lint">
    <jobs name="lint">
      <key xsi:type="bambooMM:StringLiteral" value="lint"/>
      <tasks xsi:type="bambooMM:GenericPluginTask">
        <moduleKey xsi:type="bambooMM:StringLiteral" value="com.atlassian.bamboo.plugins.cache:cache-restore-task"/>
        <configuration>
          <key name="key"/>
          <value xsi:type="bambooMM:StringLiteral" value="${CI_COMMIT_REF_SLUG}-node-modules"/>
        </configuration>
        <configuration>
          <key name="path"/>
          <value xsi:type="bambooMM:StringLiteral" value="node_modules/"/>
        </configuration>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm run lint"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm run format:check"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="cd frontend &amp;&amp; npm run lint"/>
      </tasks>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="node:20-alpine"/>
      </requirements>
    </jobs>
    <jobs name="test-unit">
      <key xsi:type="bambooMM:StringLiteral" value="test-unit"/>
      <tasks xsi:type="bambooMM:GenericPluginTask">
        <moduleKey xsi:type="bambooMM:StringLiteral" value="com.atlassian.bamboo.plugins.cache:cache-restore-task"/>
        <configuration>
          <key name="key"/>
          <value xsi:type="bambooMM:StringLiteral" value="${CI_COMMIT_REF_SLUG}-node-modules"/>
        </configuration>
        <configuration>
          <key name="path"/>
          <value xsi:type="bambooMM:StringLiteral" value="node_modules/"/>
        </configuration>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm run test:unit -- --coverage"/>
      </tasks>
      <artifacts name="unit-test-coverage" shared="true">
        <location xsi:type="bambooMM:StringLiteral" value="coverage/"/>
      </artifacts>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="node:${NODE_VERSION}-alpine"/>
      </requirements>
    </jobs>
    <jobs name="test-integration">
      <key xsi:type="bambooMM:StringLiteral" value="test-integration"/>
      <tasks xsi:type="bambooMM:GenericPluginTask">
        <moduleKey xsi:type="bambooMM:StringLiteral" value="com.atlassian.bamboo.plugins.cache:cache-restore-task"/>
        <configuration>
          <key name="key"/>
          <value xsi:type="bambooMM:StringLiteral" value="${CI_COMMIT_REF_SLUG}-node-modules"/>
        </configuration>
        <configuration>
          <key name="path"/>
          <value xsi:type="bambooMM:StringLiteral" value="node_modules/"/>
        </configuration>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm run db:migrate:test"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm run test:integration"/>
      </tasks>
      <artifacts name="integration-test-results" shared="true">
        <location xsi:type="bambooMM:StringLiteral" value="test-results/"/>
      </artifacts>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="node:20-alpine"/>
      </requirements>
    </jobs>
    <jobs name="security-scan">
      <key xsi:type="bambooMM:StringLiteral" value="security-scan"/>
      <tasks xsi:type="bambooMM:GenericPluginTask">
        <moduleKey xsi:type="bambooMM:StringLiteral" value="snyk/actions/node:master"/>
        <configuration>
          <key name="args"/>
          <value xsi:type="bambooMM:StringLiteral" value="--severity-threshold=high"/>
        </configuration>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm audit --audit-level=critical"/>
      </tasks>
      <artifacts name="security-report" shared="true">
        <location xsi:type="bambooMM:StringLiteral" value="snyk-report.sarif"/>
      </artifacts>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="node:20-alpine"/>
      </requirements>
    </jobs>
  </stages>
  <stages name="Stage-build">
    <jobs name="build">
      <key xsi:type="bambooMM:StringLiteral" value="build"/>
      <tasks xsi:type="bambooMM:GenericPluginTask">
        <moduleKey xsi:type="bambooMM:StringLiteral" value="com.atlassian.bamboo.plugins.cache:cache-restore-task"/>
        <configuration>
          <key name="key"/>
          <value xsi:type="bambooMM:StringLiteral" value="${CI_COMMIT_REF_SLUG}-node-modules"/>
        </configuration>
        <configuration>
          <key name="path"/>
          <value xsi:type="bambooMM:StringLiteral" value="node_modules/"/>
        </configuration>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm run build:backend"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="cd frontend &amp;&amp; npm run build"/>
      </tasks>
      <artifacts name="build-output" shared="true">
        <location xsi:type="bambooMM:StringLiteral" value="dist/"/>
      </artifacts>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="node:20-alpine"/>
      </requirements>
    </jobs>
  </stages>
  <stages name="Stage-docker-build">
    <jobs name="docker-build">
      <key xsi:type="bambooMM:StringLiteral" value="docker-build"/>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="docker login -u ${CI_REGISTRY_USER} -p ${CI_JOB_TOKEN} ${REGISTRY}"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="docker build --build-arg APP_VERSION=${APP_VERSION} -t ${APP_IMAGE}:${APP_VERSION} -t ${APP_IMAGE}:latest ."/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="docker tag ${APP_IMAGE}:${APP_VERSION} ${APP_IMAGE}:stable"/>
      </tasks>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="docker:24-dind"/>
      </requirements>
    </jobs>
  </stages>
  <stages name="Stage-docker-push">
    <jobs name="docker-push">
      <key xsi:type="bambooMM:StringLiteral" value="docker-push"/>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="docker login -u ${CI_REGISTRY_USER} -p ${CI_JOB_TOKEN} ${REGISTRY}"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="docker push ${APP_IMAGE}:${APP_VERSION}"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="docker push ${APP_IMAGE}:latest"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="docker push ${APP_IMAGE}:stable"/>
      </tasks>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="docker:24-dind"/>
      </requirements>
    </jobs>
  </stages>
  <stages name="Stage-deploy-staging">
    <jobs name="deploy-staging">
      <key xsi:type="bambooMM:StringLiteral" value="deploy-staging"/>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="kubectl config use-context staging"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="kubectl set image deployment/webapp app=${APP_IMAGE}:${APP_VERSION} -n staging"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="kubectl rollout status deployment/webapp -n staging --timeout=5m"/>
      </tasks>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="bitnami/kubectl:latest"/>
      </requirements>
    </jobs>
  </stages>
  <stages name="Stage-e2e-test">
    <jobs name="e2e-test">
      <key xsi:type="bambooMM:StringLiteral" value="e2e-test"/>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="npm run test:e2e -- --reporter=html"/>
      </tasks>
      <artifacts name="e2e-report" shared="true">
        <location xsi:type="bambooMM:StringLiteral" value="playwright-report/"/>
      </artifacts>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="mcr.microsoft.com/playwright:v1.44.0-jammy"/>
      </requirements>
    </jobs>
  </stages>
  <stages name="Stage-deploy-prod">
    <jobs name="deploy-prod">
      <key xsi:type="bambooMM:StringLiteral" value="deploy-prod"/>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="kubectl config use-context production"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="kubectl set image deployment/webapp app=${APP_IMAGE}:${APP_VERSION} -n production"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="kubectl rollout status deployment/webapp -n production --timeout=10m"/>
      </tasks>
      <tasks xsi:type="bambooMM:ScriptTask">
        <inlineBody xsi:type="bambooMM:StringLiteral" value="kubectl annotate deployment/webapp version=${CI_COMMIT_TAG} -n production --overwrite"/>
      </tasks>
      <requirements>
        <key xsi:type="bambooMM:StringLiteral" value="agent.label"/>
        <matchValue xsi:type="bambooMM:StringLiteral" value="bitnami/kubectl:latest"/>
      </requirements>
    </jobs>
  </stages>
  <triggers xsi:type="bambooMM:PollingTrigger"/>
  <triggers xsi:type="bambooMM:ScheduledTrigger">
    <cronExpression xsi:type="bambooMM:StringLiteral" value="0"/>
  </triggers>
  <variables>
    <key name="REGISTRY"/>
    <value xsi:type="bambooMM:StringLiteral" value="${CI_REGISTRY}"/>
  </variables>
  <variables>
    <key name="APP_IMAGE"/>
    <value xsi:type="bambooMM:StringLiteral" value="${CI_REGISTRY_IMAGE}/fullstack-webapp"/>
  </variables>
  <variables>
    <key name="APP_VERSION"/>
    <value xsi:type="bambooMM:StringLiteral" value="${CI_COMMIT_SHORT_SHA}"/>
  </variables>
</bambooMM:Plan>
