<?xml version="1.0" encoding="ASCII"?>
<bambooMM:Plan xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bambooMM="http://www.mddoai.com/mddoai/metamodel/bamboo" name="chatbot-app">
  <project name="chatbot-app-project"/>
  <variables xsi:type="bambooMM:PlanVariable" name="IMAGE_NAME" value="${CI_REGISTRY_IMAGE}/framework-chatbot-image"/>
  <variables xsi:type="bambooMM:PlanVariable" name="IMAGE_TAG" value="${IMAGE_NAME}:${IMAGE_VERSION}-${CI_COMMIT_REF_SLUG}"/>
  <stages name="stage-0">
    <jobs name="build">
      <tasks xsi:type="bambooMM:ScriptTask" script="docker build -t ${IMAGE_TAG} ."/>
    </jobs>
    <jobs name="unitTest">
      <tasks xsi:type="bambooMM:ScriptTask" script="python3 test/run_unit_tests.py"/>
      <agent name="python:3.12-slim"/>
    </jobs>
  </stages>
  <stages name="stage-1">
    <jobs name="healthCheck">
      <tasks xsi:type="bambooMM:ScriptTask" script="./scripts/health_check.sh"/>
      <agent name="curlimages/curl:latest"/>
    </jobs>
  </stages>
  <stages name="stage-2">
    <jobs name="secretScan">
      <tasks xsi:type="bambooMM:ScriptTask" script="gitleaks detect --source . --no-git -v"/>
    </jobs>
  </stages>
  <stages name="stage-3">
    <jobs name="push">
      <tasks xsi:type="bambooMM:ScriptTask" script="docker login -u ${CI_REGISTRY_USER} -p ${CI_JOB_TOKEN} ${CI_REGISTRY}"/>
      <tasks xsi:type="bambooMM:ScriptTask" script="docker push ${IMAGE_TAG}"/>
    </jobs>
  </stages>
</bambooMM:Plan>
