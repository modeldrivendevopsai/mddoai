[comment encoding = UTF-8 /]
[module generate('http://www.mddoai.com/mddoai/metamodel/gitlab')]

[query public quoteYaml(value : String) : String =
  '''' + value + ''''
/]

[template public listItem(item : String) post (trim())]
- [item/]
[/template]

[template public generateVariable(variableDef : Variable)]
[if (variableDef.description.oclIsUndefined())]
[variableDef.name/]: [quoteYaml(variableDef.value)/]
[else]
[variableDef.name/]:
  value: [quoteYaml(variableDef.value)/]
  description: [quoteYaml(variableDef.description)/]
[/if]
[/template]

[template public generateVariables(variablesDef : Variables)]
[for (variableDef : Variable | variablesDef.variables)]
  [generateVariable(variableDef)/]
[/for]
[/template]

[template public generateCommands(commands : OrderedSet(Command))]
[for (commandDef : Command | commands)]
  [listItem(commandDef.command)/]
[/for]
[/template]

[template public generateTags(tagsDef : Tags)]
[for (tagDef : Tag | tagsDef.tags)]
  [listItem(tagDef.tag)/]
[/for]
[/template]

[template public generateOnly(onlyDef : Only)]
[for (branchDef : OnlyBranches | onlyDef.branches)]
  [listItem(branchDef.branch)/]
[/for]
[/template]

[template public generateDependencies(dependenciesDef : Dependencies)]
[for (dependencyDef : Dependency | dependenciesDef.dependencies)]
  [listItem(dependencyDef.dependency)/]
[/for]
[/template]

[template public generateReport(reportDef : Report)]
[if (not reportDef.junit.oclIsUndefined())]
  junit: [reportDef.junit/]
[/if]
[if (not reportDef.coverageReport.oclIsUndefined())]
  coverage_report: [reportDef.coverageReport/]
[/if]
[if (not reportDef.dotenv.oclIsUndefined())]
  dotenv: [reportDef.dotenv/]
[/if]
[if (not reportDef.cobertura.oclIsUndefined())]
  cobertura: [reportDef.cobertura/]
[/if]
[/template]

[template public generateArtifact(artifactDef : Artifact)]
[if (not artifactDef.name.oclIsUndefined())]
  name: [artifactDef.name/]
[/if]
[if (not artifactDef.when.oclIsUndefined())]
  when: [artifactDef.when/]
[/if]
[if (not artifactDef.expireIn.oclIsUndefined())]
  expire_in: [artifactDef.expireIn/]
[/if]
[if (not artifactDef.exposeAs.oclIsUndefined())]
  expose_as: [artifactDef.exposeAs/]
[/if]
[if (artifactDef.untracked)]
  untracked: true
[/if]
[if (artifactDef.paths->notEmpty())]
  paths:
[for (pathDef : Path | artifactDef.paths)]
    [listItem(pathDef.path)/]
[/for]
[/if]
[if (artifactDef.exclude->notEmpty())]
  exclude:
[for (excludeDef : String | artifactDef.exclude)]
    [listItem(excludeDef)/]
[/for]
[/if]
[if (not artifactDef.reports.oclIsUndefined())]
  reports:
  [generateReport(artifactDef.reports)/]
[/if]
[/template]

[template public generateDocker(dockerDef : Docker)]
[if (not dockerDef.platform.oclIsUndefined())]
  platform: [dockerDef.platform/]
[/if]
[if (not dockerDef.user.oclIsUndefined())]
  user: [dockerDef.user/]
[/if]
[/template]

[template public generateKubernetes(kubernetesDef : Kubernetes)]
[if (not kubernetesDef.user.oclIsUndefined())]
  user: [kubernetesDef.user/]
[/if]
[/template]

[template public generateImage(imageDef : Image)]
  name: [imageDef.name/]
[if (imageDef.entrypoint->notEmpty())]
  entrypoint:
[for (entrypointDef : String | imageDef.entrypoint)]
    [listItem(entrypointDef)/]
[/for]
[/if]
[if (not imageDef.docker.oclIsUndefined())]
  docker:
  [generateDocker(imageDef.docker)/]
[/if]
[if (not imageDef.kubernetes.oclIsUndefined())]
  kubernetes:
  [generateKubernetes(imageDef.kubernetes)/]
[/if]
[if (imageDef.pullPolicy->notEmpty())]
  pull_policy:
[for (policyDef : String | imageDef.pullPolicy)]
    [listItem(policyDef)/]
[/for]
[/if]
[/template]

[template public generateService(serviceDef : Service)]
- name: [serviceDef.name/]
[if (not serviceDef.alias.oclIsUndefined())]
  alias: [serviceDef.alias/]
[/if]
[if (serviceDef.entrypoint->notEmpty())]
  entrypoint:
[for (entrypointDef : String | serviceDef.entrypoint)]
    [listItem(entrypointDef)/]
[/for]
[/if]
[if (serviceDef.commands->notEmpty())]
  command:
[for (commandDef : Command | serviceDef.commands)]
    [listItem(commandDef.command)/]
[/for]
[/if]
[if (not serviceDef.docker.oclIsUndefined())]
  docker:
  [generateDocker(serviceDef.docker)/]
[/if]
[if (not serviceDef.kubernetes.oclIsUndefined())]
  kubernetes:
  [generateKubernetes(serviceDef.kubernetes)/]
[/if]
[if (serviceDef.pullPolicy->notEmpty())]
  pull_policy:
[for (policyDef : String | serviceDef.pullPolicy)]
    [listItem(policyDef)/]
[/for]
[/if]
[/template]

[template public generateKey(keyDef : Key)]
[if (not keyDef.name.oclIsUndefined())]
  name: [keyDef.name/]
[/if]
[if (keyDef.files->notEmpty())]
  files:
[for (fileDef : String | keyDef.files)]
    [listItem(fileDef)/]
[/for]
[/if]
[if (keyDef.filesCommits->notEmpty())]
  files_commits:
[for (fileCommitDef : String | keyDef.filesCommits)]
    [listItem(fileCommitDef)/]
[/for]
[/if]
[if (not keyDef.prefix.oclIsUndefined())]
  prefix: [keyDef.prefix/]
[/if]
[/template]

[template public generateCache(cacheDef : Cache)]
[if (not cacheDef.key.oclIsUndefined())]
  key:
  [generateKey(cacheDef.key)/]
[/if]
[if (cacheDef.paths->notEmpty())]
  paths:
[for (pathDef : String | cacheDef.paths)]
    [listItem(pathDef)/]
[/for]
[/if]
[if (cacheDef.untracked)]
  untracked: true
[/if]
[if (cacheDef.unprotect)]
  unprotect: true
[/if]
[if (not cacheDef.when.oclIsUndefined())]
  when: [cacheDef.when/]
[/if]
[/template]

[template public generateNeed(needDef : Need)]
[if (not needDef.job.oclIsUndefined())]
- job: [needDef.job/]
[else]
- pipeline: [needDef.pipeline/]
[/if]
[if (needDef.artifacts)]
  artifacts: true
[/if]
[if (not needDef.project.oclIsUndefined())]
  project: [needDef.project/]
[/if]
[if (not needDef.ref.oclIsUndefined())]
  ref: [needDef.ref/]
[/if]
[if (not needDef.job.oclIsUndefined() and not needDef.pipeline.oclIsUndefined())]
  pipeline: [needDef.pipeline/]
[/if]
[if (needDef.optional)]
  optional: true
[/if]
[/template]

[template public generateEnvironment(environmentDef : Environment)]
[if (not environmentDef.name.oclIsUndefined())]
  name: [environmentDef.name/]
[/if]
[if (not environmentDef.url.oclIsUndefined())]
  url: [environmentDef.url/]
[/if]
[if (not environmentDef.onStop.oclIsUndefined())]
  on_stop: [environmentDef.onStop/]
[/if]
[if (not environmentDef.action.oclIsUndefined())]
  action: [environmentDef.action/]
[/if]
[if (not environmentDef.autoStopIn.oclIsUndefined())]
  auto_stop_in: [environmentDef.autoStopIn/]
[/if]
[if (not environmentDef.kubernetes.oclIsUndefined())]
  kubernetes:
  [generateKubernetes(environmentDef.kubernetes)/]
[/if]
[/template]

[template public generateRetry(retryDef : Retry)]
  max: [retryDef.max/]
[if (retryDef.when->notEmpty())]
  when:
[for (whenDef : String | retryDef.when)]
    [listItem(whenDef)/]
[/for]
[/if]
[/template]

[template public generateValuesList(values : OrderedSet(String)) post (trim())]
[for (valueDef : String | values) before ('[') separator (', ') after (']')][valueDef/][/for]
[/template]

[template public generateAxis(axisDef : Axis)]
- [axisDef.name/]: [generateValuesList(axisDef.values)/]
[/template]

[template public generateParallel(parallelDef : Parallel)]
  matrix:
[for (axisDef : Axis | parallelDef.matrix.axes)]
    [generateAxis(axisDef)/]
[/for]
[/template]

[template public generateRule(ruleDef : GitlabRule)]
[if (not ruleDef.gitlabIf.oclIsUndefined())]
- if: [quoteYaml(ruleDef.gitlabIf)/]
[else]
- when: [if (ruleDef.when.oclIsUndefined())]always[else][ruleDef.when/][/if]
[/if]
[if (not ruleDef.gitlabIf.oclIsUndefined() and not ruleDef.when.oclIsUndefined())]
  when: [ruleDef.when/]
[/if]
[if (ruleDef.changes->notEmpty())]
  changes:
[for (changeDef : String | ruleDef.changes)]
    [listItem(changeDef)/]
[/for]
[/if]
[if (ruleDef.exists->notEmpty())]
  exists:
[for (existsDef : String | ruleDef.exists)]
    [listItem(existsDef)/]
[/for]
[/if]
[if (ruleDef.allowFailure)]
  allow_failure: true
[/if]
[if (not ruleDef.variables.oclIsUndefined())]
  variables:
  [generateVariables(ruleDef.variables)/]
[/if]
[/template]

[template public generateWorkflow(workflowDef : Workflow)]
[if (workflowDef.rules->notEmpty())]
  rules:
[for (ruleDef : GitlabRule | workflowDef.rules)]
    [generateRule(ruleDef)/]
[/for]
[/if]
[/template]

[template public generateDefault(defaultDef : Default)]
[if (not defaultDef.image.oclIsUndefined())]
  image:
  [generateImage(defaultDef.image)/]
[/if]
[if (defaultDef.services->notEmpty())]
  services:
[for (serviceDef : Service | defaultDef.services)]
    [generateService(serviceDef)/]
[/for]
[/if]
[if (not defaultDef.tags.oclIsUndefined())]
  tags:
  [generateTags(defaultDef.tags)/]
[/if]
[if (not defaultDef.cache.oclIsUndefined())]
  cache:
  [generateCache(defaultDef.cache)/]
[/if]
[if (not defaultDef.beforeScript.oclIsUndefined())]
  before_script:
  [generateCommands(defaultDef.beforeScript.commands)/]
[/if]
[if (not defaultDef.afterScript.oclIsUndefined())]
  after_script:
  [generateCommands(defaultDef.afterScript.commands)/]
[/if]
[if (not defaultDef.timeout.oclIsUndefined())]
  timeout: [defaultDef.timeout/]
[/if]
[if (defaultDef.interruptible)]
  interruptible: true
[/if]
[if (not defaultDef.retry.oclIsUndefined())]
  retry:
  [generateRetry(defaultDef.retry)/]
[/if]
[/template]

[template public generateJob(jobDef : Job)]
[jobDef.name/]:
[if (not jobDef.stage.oclIsUndefined())]
  stage: [jobDef.stage/]
[/if]
[if (not jobDef.image.oclIsUndefined())]
  image:
  [generateImage(jobDef.image)/]
[/if]
[if (jobDef.services->notEmpty())]
  services:
[for (serviceDef : Service | jobDef.services)]
    [generateService(serviceDef)/]
[/for]
[/if]
[if (not jobDef.variables.oclIsUndefined())]
  variables:
  [generateVariables(jobDef.variables)/]
[/if]
[if (not jobDef.beforeScript.oclIsUndefined())]
  before_script:
  [generateCommands(jobDef.beforeScript.commands)/]
[/if]
[if (not jobDef.script.oclIsUndefined())]
  script:
  [generateCommands(jobDef.script.commands)/]
[/if]
[if (not jobDef.afterScript.oclIsUndefined())]
  after_script:
  [generateCommands(jobDef.afterScript.commands)/]
[/if]
[if (not jobDef.tags.oclIsUndefined())]
  tags:
  [generateTags(jobDef.tags)/]
[/if]
[if (not jobDef.only.oclIsUndefined())]
  only:
  [generateOnly(jobDef.only)/]
[/if]
[if (not jobDef.dependencies.oclIsUndefined())]
  dependencies:
  [generateDependencies(jobDef.dependencies)/]
[/if]
[if (not jobDef.when.oclIsUndefined())]
  when: [jobDef.when/]
[/if]
[if (jobDef.allowFailure)]
  allow_failure: true
[/if]
[if (not jobDef.timeout.oclIsUndefined())]
  timeout: [jobDef.timeout/]
[/if]
[if (jobDef.interruptible)]
  interruptible: true
[/if]
[if (not jobDef.resourceGroup.oclIsUndefined())]
  resource_group: [jobDef.resourceGroup/]
[/if]
[if (not jobDef.artifacts.oclIsUndefined())]
  artifacts:
  [generateArtifact(jobDef.artifacts)/]
[/if]
[if (not jobDef.cache.oclIsUndefined())]
  cache:
  [generateCache(jobDef.cache)/]
[/if]
[if (jobDef.rules->notEmpty())]
  rules:
[for (ruleDef : GitlabRule | jobDef.rules)]
    [generateRule(ruleDef)/]
[/for]
[/if]
[if (jobDef.needs->notEmpty())]
  needs:
[for (needDef : Need | jobDef.needs)]
    [generateNeed(needDef)/]
[/for]
[/if]
[if (not jobDef.environment.oclIsUndefined())]
  environment:
  [generateEnvironment(jobDef.environment)/]
[/if]
[if (not jobDef.retry.oclIsUndefined())]
  retry:
  [generateRetry(jobDef.retry)/]
[/if]
[if (not jobDef.parallel.oclIsUndefined())]
[if (jobDef.parallel.matrix.oclIsUndefined())]
  parallel: [jobDef.parallel.count/]
[else]
  parallel:
  [generateParallel(jobDef.parallel)/]
[/if]
[/if]
[/template]

[template public generateElement(pipelineDef : Pipeline)]
[comment @main/]
[file ('.gitlab-ci.yml', false, 'UTF-8')]
[if (pipelineDef.stages->notEmpty())]
stages:
[for (stageDef : String | pipelineDef.stages)]
  [listItem(stageDef)/]
[/for]

[/if]
[if (not pipelineDef.variables.oclIsUndefined())]
variables:
[generateVariables(pipelineDef.variables)/]

[/if]
[if (not pipelineDef.workflow.oclIsUndefined())]
workflow:
[generateWorkflow(pipelineDef.workflow)/]

[/if]
[if (not pipelineDef.default.oclIsUndefined())]
default:
[generateDefault(pipelineDef.default)/]

[/if]
[for (jobDef : Job | pipelineDef.jobs)]
[generateJob(jobDef)/]

[/for]
[/file]
[/template]