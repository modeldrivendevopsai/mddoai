[comment encoding = UTF-8 /]
[module generate('http://www.mddoai.com/mddoai/metamodel/gitlab')]

[query public quoteYamlDouble(value : String) : String = '"' + value + '"' /]

[query public quoteYamlSingle(value : String) : String = '''' + value + '''' /]

[query public renderMatrixValues(values : OrderedSet(String)) : String =
  '[' + values->iterate(v : String; acc : String = '' | if acc = '' then quoteYamlDouble(v) else acc + ', ' + quoteYamlDouble(v) endif) + ']'
/]

[template public stageItem(stage : String) post (trim())]
- [stage/]
[/template]

[template public scriptItem(cmd : String) post (trim())]
- [quoteYamlSingle(cmd)/]
[/template]

[template public tagItem(tag : String) post (trim())]
- [tag/]
[/template]

[template public branchItem(branch : String) post (trim())]
- [branch/]
[/template]

[template public dependencyItem(dep : String) post (trim())]
- [dep/]
[/template]

[template public generateVariables(variables : Variables) post (trim())]
[for (variable : Variable | variables.variables)]
[variableItem(variable)/]
[/for]
[/template]

[template public variableItem(variable : Variable) post (trim())]
[if (not variable.description.oclIsUndefined())]
[variable.name/]:
  value: [variable.value/]
  description: [variable.description/]
  expand: [variable.expand/]
[else]
[variable.name/]: [variable.value/]
[/if]
[/template]

[template public generateDocker(docker : Docker) post (trim())]
[if (not docker.platform.oclIsUndefined())]
platform: [docker.platform/]
[/if]
[if (not docker.user.oclIsUndefined())]
user: [docker.user/]
[/if]
[/template]

[template public generateKubernetes(kubernetes : Kubernetes) post (trim())]
[if (not kubernetes.user.oclIsUndefined())]
user: [kubernetes.user/]
[/if]
[/template]

[template public generateImage(image : Image) post (trim())]
name: [image.name/]
[if (image.entrypoint->notEmpty())]
entrypoint:
[for (ep : String | image.entrypoint)]
  - [ep/]
[/for]
[/if]
[if (not image.docker.oclIsUndefined())]
docker:
  [generateDocker(image.docker)/]
[/if]
[if (not image.kubernetes.oclIsUndefined())]
kubernetes:
  [generateKubernetes(image.kubernetes)/]
[/if]
[if (image.pullPolicy->notEmpty())]
pull_policy:
[for (pp : String | image.pullPolicy)]
  - [pp/]
[/for]
[/if]
[/template]

[template public generateKey(key : Key) post (trim())]
[if (not key.name.oclIsUndefined())]
name: [key.name/]
[/if]
[if (key.files->notEmpty())]
files:
[for (f : String | key.files)]
  - [f/]
[/for]
[/if]
[if (key.filesCommits->notEmpty())]
files_commits:
[for (f : String | key.filesCommits)]
  - [f/]
[/for]
[/if]
[if (not key.prefix.oclIsUndefined())]
prefix: [key.prefix/]
[/if]
[/template]

[template public generateCache(cache : Cache) post (trim())]
[if (not cache.key.oclIsUndefined())]
key:
  [generateKey(cache.key)/]
[/if]
[if (cache.paths->notEmpty())]
paths:
[for (p : String | cache.paths)]
  - [p/]
[/for]
[/if]
untracked: [cache.untracked/]
unprotect: [cache.unprotect/]
[if (not cache.when.oclIsUndefined())]
when: [cache.when/]
[/if]
[/template]

[template public generateReport(report : Report) post (trim())]
junit: [report.junit/]
[if (not report.coverageReport.oclIsUndefined())]
coverage_report: [report.coverageReport/]
[/if]
[if (not report.dotenv.oclIsUndefined())]
dotenv: [report.dotenv/]
[/if]
[if (not report.cobertura.oclIsUndefined())]
cobertura: [report.cobertura/]
[/if]
[/template]

[template public generateArtifacts(artifact : Artifact) post (trim())]
[if (not artifact.when.oclIsUndefined())]
when: [artifact.when/]
[/if]
[if (not artifact.reports.oclIsUndefined())]
reports:
  [generateReport(artifact.reports)/]
[/if]
[if (artifact.paths->notEmpty())]
paths:
[for (p : Path | artifact.paths)]
  - [p.path/]
[/for]
[/if]
[if (not artifact.name.oclIsUndefined())]
name: [artifact.name/]
[/if]
[if (not artifact.expireIn.oclIsUndefined())]
expire_in: [artifact.expireIn/]
[/if]
[if (not artifact.exposeAs.oclIsUndefined())]
expose_as: [artifact.exposeAs/]
[/if]
untracked: [artifact.untracked/]
[if (artifact.exclude->notEmpty())]
exclude:
[for (ex : String | artifact.exclude)]
  - [ex/]
[/for]
[/if]
[/template]

[template public generateEnvironment(env : Environment) post (trim())]
name: [env.name/]
[if (not env.url.oclIsUndefined())]
url: [env.url/]
[/if]
[if (not env.onStop.oclIsUndefined())]
on_stop: [env.onStop/]
[/if]
[if (not env.action.oclIsUndefined())]
action: [env.action/]
[/if]
[if (not env.autoStopIn.oclIsUndefined())]
auto_stop_in: [env.autoStopIn/]
[/if]
[if (not env.kubernetes.oclIsUndefined())]
kubernetes:
  [generateKubernetes(env.kubernetes)/]
[/if]
[/template]

[template public generateRetry(retry : Retry) post (trim())]
max: [retry.max/]
[if (retry.when->notEmpty())]
when:
[for (w : String | retry.when)]
  - [w/]
[/for]
[/if]
[/template]

[template public axisItem(axis : Axis) post (trim())]
- [axis.name/]: [renderMatrixValues(axis.values)/]
[/template]

[template public generateParallelBlock(parallel : Parallel) post (trim())]
[if (not parallel.matrix.oclIsUndefined())]
parallel:
  matrix:
[for (axis : Axis | parallel.matrix.axes)]
    [axisItem(axis)/]
[/for]
[else]
parallel: [parallel.count/]
[/if]
[/template]

[template public ruleItem(rule : GitlabRule) post (trim())]
-
[if (not rule.gitlabIf.oclIsUndefined())]
  if: [quoteYamlSingle(rule.gitlabIf)/]
[/if]
[if (not rule.when.oclIsUndefined())]
  when: [rule.when/]
[/if]
[if (rule.changes->notEmpty())]
  changes:
[for (c : String | rule.changes)]
    - [c/]
[/for]
[/if]
[if (rule.exists->notEmpty())]
  exists:
[for (e : String | rule.exists)]
    - [e/]
[/for]
[/if]
  allow_failure: [rule.allowFailure/]
[if (not rule.variables.oclIsUndefined())]
  variables:
    [generateVariables(rule.variables)/]
[/if]
[/template]

[template public needItem(need : Need) post (trim())]
-
  job: [need.job/]
[if (not need.project.oclIsUndefined())]
  project: [need.project/]
[/if]
[if (not need.ref.oclIsUndefined())]
  ref: [need.ref/]
[/if]
[if (not need.pipeline.oclIsUndefined())]
  pipeline: [need.pipeline/]
[/if]
  artifacts: [need.artifacts/]
  optional: [need.optional/]
[/template]

[template public serviceItem(service : Service) post (trim())]
-
  name: [service.name/]
[if (not service.alias.oclIsUndefined())]
  alias: [service.alias/]
[/if]
[if (service.entrypoint->notEmpty())]
  entrypoint:
[for (ep : String | service.entrypoint)]
    - [ep/]
[/for]
[/if]
[if (service.commands->notEmpty())]
  command:
[for (cmd : Command | service.commands)]
    - [quoteYamlSingle(cmd.command)/]
[/for]
[/if]
[if (not service.docker.oclIsUndefined())]
  docker:
    [generateDocker(service.docker)/]
[/if]
[if (not service.kubernetes.oclIsUndefined())]
  kubernetes:
    [generateKubernetes(service.kubernetes)/]
[/if]
[if (service.pullPolicy->notEmpty())]
  pull_policy:
[for (pp : String | service.pullPolicy)]
    - [pp/]
[/for]
[/if]
[/template]

[template public generateWorkflow(workflow : Workflow) post (trim())]
[if (workflow.rules->notEmpty())]
rules:
[for (rule : GitlabRule | workflow.rules)]
  [ruleItem(rule)/]
[/for]
[/if]
[/template]

[template public generateDefault(default : Default) post (trim())]
[if (not default.image.oclIsUndefined())]
image:
  [generateImage(default.image)/]
[/if]
[if (default.services->notEmpty())]
services:
[for (service : Service | default.services)]
  [serviceItem(service)/]
[/for]
[/if]
[if (not default.tags.oclIsUndefined())]
tags:
[for (tag : Tag | default.tags.tags)]
  [tagItem(tag.tag)/]
[/for]
[/if]
[if (not default.cache.oclIsUndefined())]
cache:
  [generateCache(default.cache)/]
[/if]
[if (not default.beforeScript.oclIsUndefined())]
before_script:
[for (cmd : Command | default.beforeScript.commands)]
  [scriptItem(cmd.command)/]
[/for]
[/if]
[if (not default.afterScript.oclIsUndefined())]
after_script:
[for (cmd : Command | default.afterScript.commands)]
  [scriptItem(cmd.command)/]
[/for]
[/if]
[if (not default.timeout.oclIsUndefined())]
timeout: [default.timeout/]
[/if]
interruptible: [default.interruptible/]
[if (not default.retry.oclIsUndefined())]
retry:
  [generateRetry(default.retry)/]
[/if]
[/template]

[template public generateJob(job : Job) post (trim())]
[job.name/]:
  stage: [job.stage/]
[if (not job.image.oclIsUndefined())]
  image:
    [generateImage(job.image)/]
[/if]
[if (not job.variables.oclIsUndefined())]
  variables:
    [generateVariables(job.variables)/]
[/if]
[if (not job.beforeScript.oclIsUndefined())]
  before_script:
[for (cmd : Command | job.beforeScript.commands)]
    [scriptItem(cmd.command)/]
[/for]
[/if]
[if (not job.script.oclIsUndefined())]
  script:
[for (cmd : Command | job.script.commands)]
    [scriptItem(cmd.command)/]
[/for]
[/if]
[if (not job.afterScript.oclIsUndefined())]
  after_script:
[for (cmd : Command | job.afterScript.commands)]
    [scriptItem(cmd.command)/]
[/for]
[/if]
[if (not job.tags.oclIsUndefined())]
  tags:
[for (tag : Tag | job.tags.tags)]
    [tagItem(tag.tag)/]
[/for]
[/if]
[if (not job.only.oclIsUndefined())]
  only:
    branches:
[for (branch : OnlyBranches | job.only.branches)]
      [branchItem(branch.branch)/]
[/for]
[/if]
[if (not job.dependencies.oclIsUndefined())]
  dependencies:
[for (dep : Dependency | job.dependencies.dependencies)]
    [dependencyItem(dep.dependency)/]
[/for]
[/if]
[if (not job.when.oclIsUndefined())]
  when: [job.when/]
[/if]
  allow_failure: [job.allowFailure/]
[if (not job.timeout.oclIsUndefined())]
  timeout: [job.timeout/]
[/if]
  interruptible: [job.interruptible/]
[if (not job.resourceGroup.oclIsUndefined())]
  resource_group: [job.resourceGroup/]
[/if]
[if (not job.cache.oclIsUndefined())]
  cache:
    [generateCache(job.cache)/]
[/if]
[if (job.rules->notEmpty())]
  rules:
[for (rule : GitlabRule | job.rules)]
    [ruleItem(rule)/]
[/for]
[/if]
[if (job.needs->notEmpty())]
  needs:
[for (need : Need | job.needs)]
    [needItem(need)/]
[/for]
[/if]
[if (job.services->notEmpty())]
  services:
[for (service : Service | job.services)]
    [serviceItem(service)/]
[/for]
[/if]
[if (not job.environment.oclIsUndefined())]
  environment:
    [generateEnvironment(job.environment)/]
[/if]
[if (not job.retry.oclIsUndefined())]
  retry:
    [generateRetry(job.retry)/]
[/if]
[if (not job.artifacts.oclIsUndefined())]
  artifacts:
    [generateArtifacts(job.artifacts)/]
[/if]
[if (not job.parallel.oclIsUndefined())]
  [generateParallelBlock(job.parallel)/]
[/if]
[/template]

[template public generateElement(pipeline : Pipeline)]
[comment @main/]
[file ('.gitlab-ci.yml', false, 'UTF-8')]
[if (pipeline.stages->notEmpty())]
stages:
[for (stage : String | pipeline.stages)]
  [stageItem(stage)/]
[/for]

[/if]
[if (not pipeline.variables.oclIsUndefined())]
variables:
  [generateVariables(pipeline.variables)/]

[/if]
[if (not pipeline.workflow.oclIsUndefined())]
workflow:
  [generateWorkflow(pipeline.workflow)/]

[/if]
[if (not pipeline.default.oclIsUndefined())]
default:
  [generateDefault(pipeline.default)/]

[/if]
[for (job : Job | pipeline.jobs)]
[generateJob(job)/]

[/for]
[/file]
[/template]