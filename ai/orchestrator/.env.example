# Base URL of the ai-layer service this orchestrator calls for LLM
# completions: narration, send_message()'s tool-routing decision, and
# GET /providers all call ai_layer_client directly.
# Local dev default (ai-layer run directly with uvicorn): http://localhost:8000
# Docker Compose: http://ai-layer:8000 (set in docker-compose.yml, not needed here)
AI_LAYER_URL=http://localhost:8000

# Base URL of the integration_runner service — the pipeline state machine,
# reached only over HTTP (see clients/integration_runner_client.py), never
# imported as a Python package.
# Local dev default (integration_runner run directly with uvicorn): http://localhost:8050
# Docker Compose: http://integration-runner:8050 (set in docker-compose.yml, not needed here)
INTEGRATION_RUNNER_URL=http://localhost:8050
