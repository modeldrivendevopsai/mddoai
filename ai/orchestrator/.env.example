# Base URL of the ai-layer service this orchestrator calls for LLM
# completions: narration, accept_message()'s tool-routing decision, and
# GET /providers all call ai_layer_client directly.
# Local dev default (ai-layer run directly with uvicorn): http://localhost:8000
# Docker Compose: http://ai-layer:8000 (set in docker-compose.yml, not needed here)
AI_LAYER_URL=http://localhost:8000

# Base URL of the integration_runner service — the pipeline state machine,
# reached only over HTTP (see clients/integration_runner_client.py), never
# imported as a Python package.
# Local dev default (integration_runner run directly with uvicorn): http://localhost:8050
# Docker Compose: http://integration-runner:8050 (set in docker-compose.yml, not needed here)
INTEGRATION_RUNNER_URL=http://localhost:8050

# Base URL of the journal, where each run's chat is kept and platforms are purged.
# Local dev default: http://localhost:8120
# Docker Compose: http://journal:8120 (set in docker-compose.yml, not needed here)
JOURNAL_URL=http://localhost:8120

# Optional overrides for the generous (15-16 minute) default timeouts this
# service's real, LLM-touching or crawl-touching calls use (see
# clients/ai_layer_client.py and integration_runner_client.py for what each
# one bounds and why — DOCS_EXTEND_TIMEOUT specifically covers the
# add_page_to_docs tool's real page fetch, which runs synchronously inline
# rather than in the background). Real free-tier LLM/crawl latency is
# unpredictable enough that these default high; lower them here only if you
# have a specific reason to fail faster instead.
# LLM_CHAT_TIMEOUT=900.0
# DOCS_EXTEND_TIMEOUT=960.0

# Optional overrides for how this service talks to the journal (see
# clients/journal_client.py for what each one bounds and why). A save waits at most
# JOURNAL_SAVE_TIMEOUT seconds, and after one fails further saves are skipped for
# JOURNAL_RETRY_COOLDOWN seconds. Saved histories are asked for JOURNAL_LOAD_ATTEMPTS
# times, JOURNAL_LOAD_RETRY_DELAY seconds apart, when the service starts.
# JOURNAL_SAVE_TIMEOUT=5.0
# JOURNAL_READ_TIMEOUT=60.0
# JOURNAL_PUBLISH_TIMEOUT=30.0
# JOURNAL_RETRY_COOLDOWN=5.0
# JOURNAL_LOAD_ATTEMPTS=10
# JOURNAL_LOAD_RETRY_DELAY=3.0
