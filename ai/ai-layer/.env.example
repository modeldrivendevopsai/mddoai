# Free-tier providers (all optional — missing keys are skipped silently)
GOOGLE_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# Optional overrides for the LiteLLM model ID each provider uses (see router/config.py's
# MODELS list for today's defaults). Free-tier providers retire specific model IDs on
# their own schedule — when that happens, set the replacement ID here and restart, no
# code change or rebuild needed.
# GEMINI_FLASH_MODEL=gemini/gemini-2.5-flash
# MISTRAL_SMALL_MODEL=mistral/mistral-small-latest
# CEREBRAS_MODEL=cerebras/gpt-oss-120b
# GROQ_MODEL=groq/openai/gpt-oss-120b

# Claude Pro/Max subscription — alternative to ANTHROPIC_API_KEY with no extra API cost.
# The router tries this BEFORE the commercial ANTHROPIC_API_KEY entry.
#
# Option A — manual setup (any environment):
#   Run `claude setup-token` once, copy the printed token, paste it here.
#
# Option B — auto-detect (if you have run `claude login` on this machine):
#   Leave this blank. The router reads the token fresh from
#   ~/.claude/.credentials.json (written by `claude login`) on every request,
#   so it picks up the CLI's own background refresh automatically.
#   Running via `docker compose`: ai/docker-compose.yml mounts ${HOME}/.claude
#   into the ai-layer container read-only so this file is actually reachable —
#   the container's own $HOME has no such file otherwise.
#
# Either way, gives access to claude-haiku-4-5 at no additional API cost.
CLAUDE_CODE_OAUTH_TOKEN=

# Commercial fallback (used only when all free providers are exhausted)
ANTHROPIC_API_KEY=
