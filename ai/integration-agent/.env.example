# All optional — real defaults live in main.py/validator_runner.py.

# Logging verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Max time to wait for one validation subprocess before treating it as an
# infra failure. Unmeasured placeholder — every real call logs duration_ms,
# tighten this once real numbers exist.
VALIDATOR_TIMEOUT_SECONDS=60

# Max accepted request body size for /validate/ecore's content field, in bytes.
MAX_CONTENT_BYTES=5242880

# Where the built main/ distribution's flat lib/ directory lives. In Docker,
# docker-compose.yml always sets this explicitly (the gradle-builder volume
# mount path) — this value only matters for a local (non-Docker) run against
# a sibling main/ checkout already built via `cd main && ./gradlew installDist`,
# and matches validator_runner.py's own real code default.
VALIDATOR_LIB_DIR=../../main/build/install/com.mddoai/lib
