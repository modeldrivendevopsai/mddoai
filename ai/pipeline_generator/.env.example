# All optional, real defaults live in this service's own modules.

# Logging verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Where validator_agent is reached. Read by the shared validator client, not by
# this service's own code. In Docker it is always set explicitly.
VALIDATOR_AGENT_URL=http://localhost:8020

# The engine's classpath directory (the built main/ distribution's flat lib/).
# In Docker it is set to the gradle-builder volume mount.
# This value only matters for a local (non-Docker) run against a sibling main/
# checkout already built via `cd main && ./gradlew installDist`.
GENERATOR_LIB_DIR=../../main/build/install/com.mddoai/lib

# The directory of compiled ATL transformations (.asm) the engine loads. Every
# request gets a scratch working directory seeded with only these files.
ENGINE_TRANSFORMATIONS_DIR=../../main/src/main/resources/transformations

# Max time to wait for one engine run before treating it as a failure. Unmeasured
# placeholder, every real run reports duration_ms, tighten once real numbers exist.
GENERATOR_TIMEOUT_SECONDS=60

# The workspace folder: models are picked from it and generated pipeline files
# are saved into it. Every path a caller gives is read as relative to it, and
# nothing outside it is listed, read or written. In Docker it is /workspace,
# with GENERATOR_WORKSPACE_HOST_DIR (default: this repository) mounted there.
# Set that variable in the shell or in ai/.env (not here) to use a folder of
# your own.
GENERATOR_WORKSPACE_DIR=./workspace

# How the Browse dialog names the workspace folder. In Docker, compose sets it
# to the host folder; unset, the folder's own path is shown.
# GENERATOR_WORKSPACE_LABEL=

# Where generated pipelines are kept so they can be reopened, in a pipelines/
# folder inside it. In Docker the stack's host data folder (MDDOAI_DATA_DIR)
# provides that pipelines/ folder.
GENERATOR_DATA_DIR=./data

# How many generated pipelines are kept for the "Your pipelines" list. The
# oldest are forgotten beyond this.
GENERATOR_MAX_PIPELINES=200

# Max accepted size of an uploaded or workspace Software Architecture model, in
# bytes.
GENERATOR_MAX_MODEL_BYTES=262144

# Max size of a file read back from the engine, and of a pipeline /validate
# accepts, in bytes. One setting so a pipeline the engine can write can always
# be validated.
GENERATOR_MAX_PIPELINE_BYTES=524288
