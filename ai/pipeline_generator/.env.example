# Everything below is optional except the folders marked REQUIRED. Real
# defaults live in this service's own modules.

# Logging verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Where the services this one calls are reached. Read by the shared clients,
# not by this service's own code. In Docker they are always set explicitly.
VALIDATOR_AGENT_URL=http://localhost:8020
EXECUTION_AGENT_URL=http://localhost:8090

# How many generations run at once; the rest wait their turn. Each one runs
# three steps in other services (engineering guess).
GENERATOR_MAX_RUNNING_JOBS=2

# How many finished generations are kept for their callers to fetch. A browser
# fetches its own within seconds (engineering guess).
GENERATOR_MAX_FINISHED_JOBS=100

# REQUIRED. Compose sets these. Outside Docker, export them in your shell:
# uvicorn does not read this file.

# The folder models are picked from.
# GENERATOR_WORKSPACE_DIR=/path/to/your/models

# How Browse names the workspace folder.
# GENERATOR_WORKSPACE_LABEL=/path/to/your/models

# The platforms folder. It must already hold the platforms.
# GENERATOR_PLATFORMS_DIR=/path/to/your/platforms

# Where generated pipelines are kept.
# GENERATOR_PIPELINES_DIR=/path/to/a/folder

# How many generated pipelines are kept for the "Your pipelines" list. The
# oldest are forgotten beyond this.
GENERATOR_MAX_PIPELINES=200

# Max accepted size of an uploaded or workspace Software Architecture model, in
# bytes.
GENERATOR_MAX_MODEL_BYTES=262144

# Max size of a pipeline a template may produce, and of a pipeline /validate
# accepts, in bytes. validator-agent's own MAX_PIPELINE_BYTES must be at least
# this large.
GENERATOR_MAX_PIPELINE_BYTES=524288
