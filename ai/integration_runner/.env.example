# Base URL of the ai-layer service the placeholder stage agents (pim/psm/
# atl/acceleo/generation) and the docs stage call for LLM completions.
# Local dev default (ai-layer run directly with uvicorn): http://localhost:8000
# Docker Compose: http://ai-layer:8000 (set in docker-compose.yml, not needed here)
AI_LAYER_URL=http://localhost:8000

# Base URL of the retrieval service the docs stage calls to fetch a platform's
# real documentation. Local dev default: http://localhost:8010
# Docker Compose: http://retrieval:8010 (set in docker-compose.yml, not needed here)
RETRIEVAL_URL=http://localhost:8010

# Base URL of the serialization_agent service the serialization stage calls
# to turn the docs stage's raw output into a PIM-concept-labeled markdown
# artifact. Local dev default: http://localhost:8060
# Docker Compose: http://serialization-agent:8060 (set in docker-compose.yml, not needed here)
SERIALIZATION_AGENT_URL=http://localhost:8060

# Optional, unset by default. Set to "1" to make the docs stage skip the real
# retrieval crawl and return canned output instantly, for iterating on the
# pipeline's mechanics (approve/reject/retry/message) without needing a
# real, valid documentation URL or waiting on a real 90+ second crawl each
# time. Leave unset for a real run, this is a local testing convenience only,
# never set it in docker-compose.yml's committed defaults.
# ORCHESTRATOR_STUB_DOCS=1
