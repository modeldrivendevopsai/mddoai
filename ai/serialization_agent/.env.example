# Base URL of the ai-layer service, for the extraction step's LLM call.
# Local dev default: http://localhost:8000
# Docker Compose: http://ai-layer:8000 (set in docker-compose.yml, not needed here)
AI_LAYER_URL=http://localhost:8000

# Base URL of the pim_agent service, for labeling extracted fragments
# against the real PIM concepts. Local dev default: http://localhost:8030
# Docker Compose: http://pim-agent:8030 (set in docker-compose.yml, not needed here)
PIM_AGENT_URL=http://localhost:8030

# Optional override for the extraction step's LLM call timeout (default 15
# minutes — see clients/ai_layer_client.py's LLM_CHAT_TIMEOUT). Real
# free-tier LLM latency on a full real crawl's worth of docs text is
# unpredictable enough that this defaults high; lower it only if you have a
# specific reason to fail faster instead.
# LLM_CHAT_TIMEOUT=900.0
