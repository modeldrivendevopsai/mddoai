# REQUIRED: the six folders the journal keeps. Compose sets them from the
# environment's config.env. Outside Docker, export them in your shell: uvicorn
# does not read this file.
# JOURNAL_RUNS_DIR=/path/to/a/folder
# JOURNAL_CHATS_DIR=/path/to/a/folder
# JOURNAL_PLATFORMS_DIR=/path/to/your/platforms
# JOURNAL_PROMPTS_DIR=/path/to/your/prompts
# JOURNAL_ATTACHMENTS_DIR=/path/to/a/folder
# JOURNAL_PIPELINES_DIR=/path/to/a/folder
