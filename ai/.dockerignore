# Applies to any service whose build context is this ai/ folder (needed once
# a service's package.json depends on a sibling via a "file:../..." local
# path, since Docker can't COPY from outside its own build context — see
# ai/ui-host/Dockerfile). Glob-based, not a per-service list, so a new
# sibling folder never needs an edit here.
**/node_modules
**/dist
**/dist-ssr
**/coverage
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/venv
**/.venv
.git
**/.env
**/.env.*
**/*.local
**/.vscode
**/.idea
**/.DS_Store
# The stack's data folder: run artifacts and generator history. It only
# grows and is never part of any image, so it must never be sent as build
# context for any service that builds from ai/.
data
# The generator's own data and workspace folders, when it is run from its own
# folder and not in Docker.
pipeline_generator/data
pipeline_generator/workspace
