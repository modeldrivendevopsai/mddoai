# Every image in this folder installs its own dependencies fresh inside the
# container (npm install / pip install -r requirements.txt), so none of these
# ever need to be sent as build context - doing so only slows down every
# single build (all `context:` entries in docker-compose.yml point at this
# whole ai/ folder), it never gets used.
node_modules
venv
.venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache

# Local/editor/VCS state, never needed inside a container.
.git
.env
.vscode
.idea

# Frontend build output - Dockerfiles that need it build it themselves.
dist
build
