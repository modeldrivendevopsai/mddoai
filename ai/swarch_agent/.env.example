# Copy to .env to override these for a local (non-Docker) run. In Docker,
# docker-compose.yml sets the service URLs and the transformation path.

# The SWArch-to-PIM transformation to run, as an .atl source file. Unset, the
# engine's own transformation in this checkout is used.
# SWARCH2PIM_ATL_PATH=

# The services this one calls.
VALIDATOR_AGENT_URL=http://localhost:8020
EXECUTION_AGENT_URL=http://localhost:8090

# Max accepted size of a Software Architecture model, in bytes.
SWARCH_MAX_MODEL_BYTES=262144

LOG_LEVEL=INFO
