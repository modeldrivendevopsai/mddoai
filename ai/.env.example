# This copy of the stack's own settings. Copy this file to ai/.env before
# running any `docker compose` command in ai/; docker compose reads it from
# there. Every value below is required. Another copy on the same machine, such
# as the Test environment, has its own file with its own values.

# A second copy on the same machine also needs its own project name, so its
# containers, networks and volumes stay apart. Unset, it is the folder's name.
# COMPOSE_PROJECT_NAME=

# The port the UI is published on. It always listens on this machine only.
UI_PORT=5173

# ai-layer's port, with the address it listens on. 127.0.0.1 keeps it on this
# machine; leave the address out only if another machine needs to reach it.
AI_LAYER_PORT=127.0.0.1:8000

# The host names the UI may be opened under, separated by spaces. The UI
# refuses a request under any other name. Keep localhost in the list if you
# still open the app that way.
UI_ALLOWED_HOSTS="localhost 127.0.0.1"

# The largest request body the UI's proxy accepts. Keep it above the largest
# attachment upload the stage agents accept (their *_MAX_UPLOAD_BYTES, 5 MiB
# by default).
UI_MAX_BODY_SIZE=6m

# How long the UI's proxy waits for a service's answer. Slow work (stage runs,
# chat answers) runs in the background and answers at once, so this only
# needs to cover quick calls. Keep it under the limit of any proxy in front of
# the app: Cloudflare ends a request after 125 seconds.
UI_PROXY_READ_TIMEOUT=120s
