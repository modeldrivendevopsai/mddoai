# Copy to ai/.env before running docker compose. Every value is required.

# A second copy on the same machine needs its own name
# COMPOSE_PROJECT_NAME=

UI_PORT=5173
# Drop 127.0.0.1 only if another machine needs ai-layer
AI_LAYER_PORT=127.0.0.1:8000
UI_ALLOWED_HOSTS="localhost 127.0.0.1"
# Above the agents' 5 MiB upload limit
UI_MAX_BODY_SIZE=6m
# Under Cloudflare's 125s
UI_PROXY_READ_TIMEOUT=120s
