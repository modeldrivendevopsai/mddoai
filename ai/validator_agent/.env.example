# Everything below is optional except where it says REQUIRED. Real defaults live in
# main.py/validator_runner.py.

# Logging verbosity (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Max time to wait for one validation subprocess before treating it as an
# infra failure. Unmeasured placeholder — every real call logs duration_ms,
# tighten this once real numbers exist.
VALIDATOR_TIMEOUT_SECONDS=60

# Max accepted request body size for /validate/ecore's content field, in bytes.
MAX_CONTENT_BYTES=5242880

# Max accepted size of a generated pipeline file for /validate/pipeline, in
# bytes. Parsing YAML costs seconds per megabyte, so this is far below
# MAX_CONTENT_BYTES.
MAX_PIPELINE_BYTES=524288

# Max accepted length for run_id/stage/attempt on any /validate/* request.
# A real identifier is short (a uuid4().hex, a one-word stage name,
# "attempt_N") - nowhere near this. Confirmed directly, in a real Linux
# container matching this project's own Docker deployment, that an
# unbounded combined value can crash the validator subprocess launch with
# an OS-level "Argument list too long" instead of a clean 422.
VALIDATOR_ID_MAX_LENGTH=128

# Where the built main/ distribution's flat lib/ directory lives. In Docker,
# docker-compose.yml always sets this explicitly (the gradle-builder volume
# mount path) — this value only matters for a local (non-Docker) run against
# a sibling main/ checkout already built via `cd main && ./gradlew installDist`,
# and matches validator_runner.py's own real code default.
VALIDATOR_LIB_DIR=../../main/build/install/com.mddoai/lib

# REQUIRED: the folder every compiled artifact the validators produce (Ecore's
# codegen classes, ATL's .asm, Acceleo's .emtl) is kept in, scoped under the
# run_id, stage and attempt a request gives. The service does not start without
# it, and the Java validators (which read it too) fail naming it when it is
# missing, so there is no fallback to the temp folder. In Docker Compose it is
# set in docker-compose.yml (not needed here). For a run outside Docker, choose
# a folder of your own, outside the repository, and export it in the shell you
# start the service from (uvicorn does not read this file).
# VALIDATOR_OUTPUT_DIR=/path/to/a/folder
