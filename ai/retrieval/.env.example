# REQUIRED: no defaults. Docker Compose sets both for the retrieval container. Running
# retrieval outside Docker (`uvicorn main:app --reload`), export them in your shell:
# uvicorn does not read this file.
#
# Where ai-layer's shared /chat endpoint is reachable, used for link-selection and
# content-cleanup LLM calls. Inside Docker this is the service name, which only
# resolves in the compose network.
# AI_LAYER_URL=http://<where ai-layer runs>:<port>
# LOG_LEVEL=<DEBUG, INFO, WARNING or ERROR>

# The tuning values (page and link budgets, timeouts, cache sizes, thresholds) are in
# config.yaml, and nowhere else.
